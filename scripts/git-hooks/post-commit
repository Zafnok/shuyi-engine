#!/bin/sh
# After a merge commit, splits it in two if it carries changes of its own
# beyond resolving its parents (ticket 3532): `cargo xtask mend-merges`
# makes the merge again with only its resolution and puts the rest in a
# commit of its own, with the same files at the end. CI's `check-merges`
# (ticket 2065) refuses such a merge, and once it is pushed only a
# force-push or a new PR gets rid of it; split before the push, a plain
# push follows.
#
# Git runs it after every commit; it acts only on a merge (two parents),
# and it never fails the commit.
#
# Set it up once per clone, from the repository's root:
#
#   git config core.hooksPath scripts/git-hooks

[ "$(git rev-list --parents -n 1 HEAD 2>/dev/null | wc -w)" -eq 3 ] || exit 0
cd "$(git rev-parse --show-toplevel)" || exit 0
if ! cargo xtask mend-merges; then
  echo "post-commit: this merge couldn't be split; check-merges will refuse it, so mend it before pushing (the line above says how)." >&2
fi
exit 0
