#!/bin/sh
# Runs the fast local gates before a push (ticket 2054): `cargo xtask gates
# --fast` (fmt, typos, the ticket lint and, when Rust changed, the engine's
# lint). Then `cargo xtask check-merges` over what each ref pushes (ticket
# 3532): a merge that carries changes of its own is refused here, while
# `cargo xtask mend-merges` can still split it without a force-push. Git
# runs it, so it works whatever harness or terminal pushes.
#
# Set it up once per clone, from the repository's root:
#
#   git config core.hooksPath scripts/git-hooks
#
# `bash scripts/setup-linux.sh` does it on Linux. The slower gates are
# `cargo xtask gates`' (the run-gates skill).
set -eu

# Git hands one line per ref: `<local ref> <local sha> <remote ref> <remote sha>`.
# A push that only deletes refs sends no commit, so it needs no gate.
ranges=
while read -r _local_ref local_sha _remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac
  # From the remote's commit when this clone has it; else from main.
  base=origin/main
  case "$remote_sha" in
    *[!0]*) git cat-file -e "$remote_sha^{commit}" 2>/dev/null && base=$remote_sha ;;
  esac
  ranges="$ranges $base:$local_sha"
done
[ -n "$ranges" ] || exit 0

cd "$(git rev-parse --show-toplevel)"
if ! cargo xtask gates --fast; then
  echo "pre-push: a fast gate failed, so the push is refused. Fix it and push again." >&2
  exit 1
fi
for range in $ranges; do
  if ! cargo xtask check-merges --base "${range%%:*}" --head "${range#*:}"; then
    echo "pre-push: a merge in this push changes more than resolving its parents. Run \`cargo xtask mend-merges\` (same files, no force-push needed), then push again." >&2
    exit 1
  fi
done
