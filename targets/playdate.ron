// Panic's Playdate (ADR-0008 §1 and §6): a 1-bit 400 × 240 screen, a
// Cortex-M7 at 168 MHz and 16 MB of RAM.
(
    id: "playdate",
    status: Supported,
    display: (
        sizes: [(width: 400, height: 240)],
        color: OneBit,
        min_text_px: 8,
        good_text_px: 10,
    ),
    frame_rate: (target: 30, floor: 30),
    input: (
        // The d-pad, A (`East`) and B (`West`), and the crank, one press a
        // notch. Menu and Lock are the system's.
        buttons: [
            "DpadUp", "DpadDown", "DpadLeft", "DpadRight",
            "East", "West",
            "CrankForward", "CrankBack",
        ],
        chords: [("East", "West")],
        axes: ["Crank"],
        system_menu_slots: 3,
    ),
    // The player leaves through the system's Home: a game shows no Quit.
    quit: System,
    budgets: (
        // Provisional: half of 168 MHz ÷ 30, leaving the rest to the SDK,
        // the display and audio. 3011 measures it on the device.
        frame_instructions: 2_000_000,
        // Provisional, of 16 MB: 3011 measures it.
        peak_heap_bytes: 10_485_760, // 10 MB
        // Provisional: 3011 measures it.
        package_bytes: 41_943_040, // 40 MB
        startup_ms: 5_000,
    ),
    backend: "shuyi-playdate",
)
