// The browser build (ADR-0008 §1 and §6). The canvas takes any size.
(
    id: "web",
    status: Supported,
    display: (
        sizes: [],
        color: Rgba8,
        min_text_px: 10,
        good_text_px: 12,
    ),
    frame_rate: (target: 60, floor: 30),
    input: (
        buttons: [
            "South", "East", "West", "North",
            "LeftShoulder", "RightShoulder", "LeftTrigger", "RightTrigger",
            "Select", "Start", "LeftStickPress", "RightStickPress",
            "DpadUp", "DpadDown", "DpadLeft", "DpadRight",
            "LeftStickUp", "LeftStickDown", "LeftStickLeft", "LeftStickRight",
            "RightStickUp", "RightStickDown", "RightStickLeft", "RightStickRight",
        ],
        axes: ["LeftStick", "RightStick"],
        pointer: true,
        keyboard: true,
    ),
    budgets: (
        // Provisional: 3008's benchmarks calibrate it.
        frame_instructions: 20_000_000,
        peak_heap_bytes: 268_435_456, // 256 MB
        // Provisional: the download, measured by 3008.
        package_bytes: 26_214_400, // 25 MB
        startup_ms: 5_000, // at 25 Mbit/s
    ),
    backend: "shuyi-app",
)
