// iOS (ADR-0008 §1 and §6), parked (3015). Phones come in
// many sizes, with safe areas, so no size is fixed here yet.
(
    id: "ios",
    status: Planned,
    display: (
        sizes: [],
        color: Rgba8,
        min_text_px: 12,
        good_text_px: 16,
    ),
    frame_rate: (target: 60, floor: 30),
    input: (
        // On-screen controls by touch; a gamepad is optional.
        touch: true,
    ),
    budgets: (
        // Provisional: 3015 measures it on a four-year-old mid-range
        // phone.
        frame_instructions: 20_000_000,
        peak_heap_bytes: 314_572_800, // 300 MB
        package_bytes: 157_286_400, // 150 MB
        startup_ms: 3_000, // cold
    ),
    backend: "shuyi-app",
)
