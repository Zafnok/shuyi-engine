// Valve's Steam Deck, a Linux PC (ADR-0008 §1 and §6). Deck Verified asks
// for text at least 9 px tall at 1280 × 800, 12 px recommended, and a
// default controller layout that reaches all content.
(
    id: "steam-deck",
    status: Supported,
    display: (
        sizes: [(width: 1280, height: 800)],
        color: Rgba8,
        min_text_px: 9,
        good_text_px: 12,
    ),
    frame_rate: (target: 60, floor: 60),
    input: (
        // The gamepad only: the Steam and Quick Access buttons are the
        // system's.
        buttons: [
            "South", "East", "West", "North",
            "DpadUp", "DpadDown", "DpadLeft", "DpadRight",
            "LeftShoulder", "RightShoulder", "LeftTrigger", "RightTrigger",
            "Start", "Select",
            "LeftStickUp", "LeftStickDown", "LeftStickLeft", "LeftStickRight",
            "RightStickUp", "RightStickDown", "RightStickLeft", "RightStickRight",
            "LeftStickPress", "RightStickPress",
        ],
        axes: ["LeftStick", "RightStick"],
        // The screen is a touch screen, but nothing may need it.
        touch: true,
    ),
    budgets: (
        // Provisional: 3013 measures it on the device.
        frame_instructions: 20_000_000,
        peak_heap_bytes: 1_073_741_824, // 1 GB
        startup_ms: 3_000,
    ),
    backend: "shuyi-app",
)
