// Windows, Linux and macOS (ADR-0008 §1 and §6). A window takes any size,
// so a game shows its frame at an integer scale of its choosing.
(
    id: "desktop",
    status: Supported,
    display: (
        sizes: [],
        color: Rgba8,
        min_text_px: 10,
        good_text_px: 12,
        // A window, switched to full screen and back by the player.
        windowed: true,
    ),
    frame_rate: (target: 60, floor: 60),
    input: (
        // A gamepad, by position, beside the keyboard and the mouse.
        buttons: [
            "South", "East", "West", "North",
            "LeftShoulder", "RightShoulder", "LeftTrigger", "RightTrigger",
            "Select", "Start", "LeftStickPress", "RightStickPress",
            "DpadUp", "DpadDown", "DpadLeft", "DpadRight",
            "LeftStickUp", "LeftStickDown", "LeftStickLeft", "LeftStickRight",
            "RightStickUp", "RightStickDown", "RightStickLeft", "RightStickRight",
        ],
        axes: ["LeftStick", "RightStick"],
        pointer: true,
        keyboard: true,
    ),
    budgets: (
        // Provisional: 3008's benchmarks calibrate it.
        frame_instructions: 20_000_000,
        peak_heap_bytes: 536_870_912, // 512 MB
        startup_ms: 2_000,
    ),
    backend: "shuyi-app",
)
