// The worked example of shuyi-ship, a script of contract commands run on
// a game made with `shuyi new <dir> --template grid` (named after the
// skill: its crate is `shuyi-ship`): a target added and its controls made
// to fit, the web build, the credits, and the pack a release ships.
Example(
    template: "grid",
    steps: [
        // The game's own id in place of the placeholder (its saves are
        // kept under it), written into `app_info.rs` by `app-info`.
        Edit(
            file: "shuyi.ron",
            find: "id: \"com.example.shuyi-ship\",",
            replace: "id: \"io.github.someone.shuyi-ship\",",
        ),
        Cargo(args: ["shuyi", "app-info"]),
        // The targets `shuyi.ron` lists fit as the game is.
        Shuyi(args: ["check", "--target", "all"], expect: [
            Is("/result/targets/0/target", "desktop"),
            Is("/result/targets/0/problems", "[]"),
            Is("/result/targets/1/target", "web"),
        ]),
        // The Steam Deck has no keyboard: added to the targets, it fails
        // until the keymap gives it buttons.
        Edit(
            file: "shuyi.ron",
            find: "        \"web\": (frame: (384, 384), scale: integer, text_px: 16),\n",
            replace: "        \"web\": (frame: (384, 384), scale: integer, text_px: 16),\n        \"steam-deck\": (frame: (384, 384), scale: integer, text_px: 16),\n",
        ),
        Shuyi(args: ["check", "--target", "all"], ok: false, expect: [
            Is("/result/targets/1/target", "steam-deck"),
            Is("/result/targets/1/problems/0/check", "controls"),
            Holds("/result/targets/1/problems/0/setting", "steam-deck"),
        ]),
        Edit(
            file: "crates/game/files/keymap.ron",
            find: "    targets: {},",
            replace: "    targets: {\n        \"steam-deck\": {\n            \"Up\": [\"DpadUp\", \"LeftStickUp\"],\n            \"Down\": [\"DpadDown\", \"LeftStickDown\"],\n            \"Left\": [\"DpadLeft\", \"LeftStickLeft\"],\n            \"Right\": [\"DpadRight\", \"LeftStickRight\"],\n            \"Confirm\": [\"South\"],\n            \"Cancel\": [\"East\"],\n        },\n    },",
        ),
        Shuyi(args: ["check", "--target", "all"], expect: [
            Is("/result/targets/1/target", "steam-deck"),
            Is("/result/targets/1/problems", "[]"),
        ]),
        // The web build: a new game has its `web` entry, the build script
        // for its link argument and the web target in its toolchain file.
        Holds(file: "shuyi.ron", text: "dist: \"dist/web\""),
        Holds(file: "crates/game/build.rs", text: "--allow-undefined"),
        Cargo(args: ["shuyi", "web", "--release"]),
        Holds(file: "dist/web/index.html", text: "shuyi-ship.wasm"),
        Holds(file: "dist/web/shuyi-ship.wasm"),
        // The credits: the one third-party work a new game ships, its
        // font, read back through the format registry.
        Write(to: "crates/game/files/credits.ron", from: "example/credits.ron"),
        Shuyi(args: ["import", "crates/game/files/credits.ron"], expect: [
            Is("/result/read_as/0/kind", "credits"),
            Is("/result/errors", "[]"),
        ]),
        // Its pack, which a release export of the desktop or the web ships
        // beside the program: its text baked, and proven equal to its files.
        Shuyi(args: ["bake", "--target", "desktop", "--out", "target/shuyi/desktop.pack"], expect: [
            Is("/result/errors", "[]"),
            Is("/result/pack/kinds/0", "english"),
        ]),
        Shuyi(args: ["bake", "--target", "desktop", "--out", "target/shuyi/desktop.pack", "--check"], expect: [
            Is("/result/errors", "[]"),
        ]),
        // A release: what CI packages for each target, and where, with the
        // tag checked against the version. The Steam Deck has no exporter
        // yet: it is checked, not packaged, and the plan still passes.
        Shuyi(args: ["export", "--plan", "--tag", "v0.1.0"], expect: [
            Is("/result/version", "0.1.0"),
            Is("/result/exports/0/exporter", "windows"),
            Is("/result/exports/1/container", "registry.gitlab.steamos.cloud/steamrt/sniper/sdk:3.0.20261007.263965@sha256:220d1dc739254155a91c010f959a4f8e7c183e69d18300d6be53a20aee12b02d"),
            Is("/result/exports/3/exporter", "web"),
            Holds("/limits/0", "`steam-deck` is checked"),
        ]),
        Shuyi(args: ["export", "--plan", "--tag", "v0.2.0"], ok: false, expect: [Is("/code", "SH0001")]),
        // The gates still pass, the build script's included.
        Shuyi(args: ["check"]),
        Cargo(args: ["fmt", "--all", "--check"]),
        Cargo(args: ["clippy", "--workspace", "--all-targets", "--", "-D", "warnings"]),
        Shuyi(args: ["lint"], expect: [Is("/result/findings", "[]")]),
        Cargo(args: ["shuyi", "check-keys"]),
    ],
)
