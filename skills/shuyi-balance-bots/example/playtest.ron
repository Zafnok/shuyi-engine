// The playtest's checks (`cargo shuyi playtest`): how often each bot of
// the stage's tools (`HEROES`) should reach the goal, and that the
// rollout bot gets there in fewer turns. The bands hold for seeds 0 to
// 19: the random bot won 1 of them, the rollout bot 19.
[
    // Stepping at random rarely finds the goal before the wanderer finds
    // you.
    Rate(
        entrant: "random",
        success: [(measure: "won", min: Some(1))],
        band: (min: 0, max: 20),
    ),
    // A bot that plans nearly always gets there; under half of the time
    // means the stage can't be won, which blocks the run.
    Rate(
        entrant: "rollout",
        success: [(measure: "won", min: Some(1))],
        band: (min: 80, max: 100),
        floor: Some(50),
    ),
    // And it wins in fewer turns.
    Median(
        entrant: "rollout",
        measure: "turns",
        among: [(measure: "won", min: Some(1))],
        want: Lower,
        than: "random",
    ),
]
