{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer",
  "description": "What an operation answers.",
  "type": "object",
  "properties": {
    "code": {
      "description": "The problem code of its error (`SH1002`), or of its failure when\nit ran and failed on the setup (`doctor`); `shuyi explain <code>`\nprints its page.",
      "type": [
        "string",
        "null"
      ]
    },
    "contract": {
      "description": "The contract's version ([`VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error": {
      "description": "Why it could not run, if it could not.",
      "type": [
        "string",
        "null"
      ]
    },
    "help": {
      "description": "How to fix it, with the code.",
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "description": "What it could not determine, in plain words.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "description": "Whether it passed: nothing found by a check, runs that agree, a\ngame made, a toolchain complete. False too when it could not run.",
      "type": "boolean"
    },
    "op": {
      "description": "The operation.",
      "$ref": "#/$defs/Op"
    },
    "result": {
      "description": "What it found or made; absent when it could not run.",
      "anyOf": [
        {
          "$ref": "#/$defs/StartOutput"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "op",
    "ok",
    "limits"
  ],
  "$defs": {
    "GameArg": {
      "description": "A game option as given.",
      "type": "object",
      "properties": {
        "flag": {
          "description": "Its flag.",
          "type": "string"
        },
        "value": {
          "description": "Its value, if it takes one.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "flag"
      ]
    },
    "Op": {
      "description": "An operation of the contract.",
      "oneOf": [
        {
          "description": "A new game from a template.",
          "type": "string",
          "const": "new"
        },
        {
          "description": "Every error of the game's content.",
          "type": "string",
          "const": "check"
        },
        {
          "description": "What is wrong with the shape of the game's code.",
          "type": "string",
          "const": "lint"
        },
        {
          "description": "The catalog of modules, and the game's.",
          "type": "string",
          "const": "modules"
        },
        {
          "description": "A module turned on.",
          "type": "string",
          "const": "add"
        },
        {
          "description": "A key script played headless.",
          "type": "string",
          "const": "run"
        },
        {
          "description": "The scene on screen.",
          "type": "string",
          "const": "scene"
        },
        {
          "description": "A record replayed.",
          "type": "string",
          "const": "replay"
        },
        {
          "description": "Bots playing the game.",
          "type": "string",
          "const": "bots"
        },
        {
          "description": "Named bots' tries judged against the game's checks.",
          "type": "string",
          "const": "playtest"
        },
        {
          "description": "A stage changed until the game's named bots land in their bands.",
          "type": "string",
          "const": "autobalance"
        },
        {
          "description": "A file read through the format registry.",
          "type": "string",
          "const": "import"
        },
        {
          "description": "The game's sources baked into a pack.",
          "type": "string",
          "const": "bake"
        },
        {
          "description": "The toolchain checked.",
          "type": "string",
          "const": "doctor"
        },
        {
          "description": "A problem code's page.",
          "type": "string",
          "const": "explain"
        },
        {
          "description": "A running build reached over the live link.",
          "type": "string",
          "const": "attach"
        },
        {
          "description": "The MCP session's game started headless.",
          "type": "string",
          "const": "start"
        },
        {
          "description": "The MCP session's game played on: a script, then idle frames.",
          "type": "string",
          "const": "step"
        },
        {
          "description": "A picture of the MCP session's frame.",
          "type": "string",
          "const": "frame_png"
        },
        {
          "description": "What happened in the MCP session's game.",
          "type": "string",
          "const": "events"
        },
        {
          "description": "The MCP session's frames' records since a number.",
          "type": "string",
          "const": "perf"
        },
        {
          "description": "The MCP session's game started again.",
          "type": "string",
          "const": "reset"
        },
        {
          "description": "The MCP session's game stopped.",
          "type": "string",
          "const": "stop"
        }
      ]
    },
    "StartOption": {
      "description": "A start option the game offers.",
      "type": "object",
      "properties": {
        "flag": {
          "description": "Its flag (`--stage`).",
          "type": "string"
        },
        "help": {
          "description": "What it does.",
          "type": "string"
        },
        "value": {
          "description": "What its value is called (`N`), if it takes one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "flag",
        "help"
      ]
    },
    "StartOutput": {
      "description": "What `start` and `reset` started.",
      "type": "object",
      "properties": {
        "frames": {
          "description": "The frames run (none yet).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "game": {
          "description": "The running build's game, its window's title, when attached over\nthe link; empty when started headless.",
          "type": "string"
        },
        "options": {
          "description": "The start options the game offers.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/StartOption"
          }
        },
        "project": {
          "description": "The game's folder; empty when attached over the link.",
          "type": "string"
        },
        "screens": {
          "description": "The open screens, bottom first.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "start": {
          "description": "The start options it was started with.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GameArg"
          }
        },
        "top_screen": {
          "description": "The top screen's name.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "project",
        "game",
        "start",
        "options",
        "frames",
        "top_screen",
        "screens"
      ]
    }
  }
}
