{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer",
  "description": "What an operation answers.",
  "type": "object",
  "properties": {
    "code": {
      "description": "The problem code of its error (`SH1002`), or of its failure when\nit ran and failed on the setup (`doctor`); `shuyi explain <code>`\nprints its page.",
      "type": [
        "string",
        "null"
      ]
    },
    "contract": {
      "description": "The contract's version ([`VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error": {
      "description": "Why it could not run, if it could not.",
      "type": [
        "string",
        "null"
      ]
    },
    "help": {
      "description": "How to fix it, with the code.",
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "description": "What it could not determine, in plain words.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "description": "Whether it passed: nothing found by a check, runs that agree, a\ngame made, a toolchain complete. False too when it could not run.",
      "type": "boolean"
    },
    "op": {
      "description": "The operation.",
      "type": "string",
      "const": "scene"
    },
    "result": {
      "description": "What it found or made; absent when it could not run.",
      "anyOf": [
        {
          "$ref": "#/$defs/SceneOutput"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "op",
    "ok",
    "limits"
  ],
  "$defs": {
    "LogEntry": {
      "description": "A line of the game's log.",
      "type": "object",
      "properties": {
        "category": {
          "description": "What it is about: `assets`, `audio`, `input`, `screens`, `storage`,\n`platform` or `game`.",
          "type": "string"
        },
        "frame": {
          "description": "The frame it was given in (frames count from 1; 0 is before the\nfirst).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "level": {
          "description": "How serious it is: `error`, `warn`, `info` or `debug`.",
          "type": "string"
        },
        "text": {
          "description": "What it says, in English.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "frame",
        "level",
        "category",
        "text"
      ]
    },
    "Scene": {
      "description": "The scene a stage shows, as text and as data.",
      "type": "object",
      "properties": {
        "data": {
          "description": "What the game says of it as data: its stage's state."
        },
        "kind": {
          "description": "What kind of scene: `grid map`, or the game's own word.",
          "type": "string"
        },
        "screen": {
          "description": "The screen it is on.",
          "type": "string"
        },
        "text": {
          "description": "The scene as text: for a grid map, its tiles, units and cursor in\nthe scene's text form (`MapScene::to_text`).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "screen",
        "kind",
        "text",
        "data"
      ]
    },
    "SceneOutput": {
      "description": "What `scene` saw.",
      "type": "object",
      "properties": {
        "frames": {
          "description": "The frames run in all.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "log": {
          "description": "The game's log, oldest first: its last lines.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LogEntry"
          }
        },
        "scene": {
          "description": "The scene, if a stage is open.",
          "anyOf": [
            {
              "$ref": "#/$defs/Scene"
            },
            {
              "type": "null"
            }
          ]
        },
        "session": {
          "description": "How far the session record played, with `session`.",
          "anyOf": [
            {
              "$ref": "#/$defs/SessionPlayed"
            },
            {
              "type": "null"
            }
          ]
        },
        "top_screen": {
          "description": "The top screen's name.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "frames",
        "top_screen",
        "log"
      ]
    },
    "SessionDifference": {
      "description": "The first frame of a session record that played differently.",
      "type": "object",
      "properties": {
        "frame": {
          "description": "The frame, counted from 1.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "played": {
          "description": "The hash it played with.",
          "type": "string"
        },
        "recorded": {
          "description": "The hash the record holds for it (sixteen hex digits).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "frame",
        "recorded",
        "played"
      ]
    },
    "SessionPlayed": {
      "description": "How far a session record played.",
      "type": "object",
      "properties": {
        "file": {
          "description": "The record's file, as given.",
          "type": "string"
        },
        "first_difference": {
          "description": "The first frame that played differently: the playing stopped there,\nand neither the script nor `frames` played.",
          "anyOf": [
            {
              "$ref": "#/$defs/SessionDifference"
            },
            {
              "type": "null"
            }
          ]
        },
        "frames": {
          "description": "The record's frames played.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "of": {
          "description": "The frames the record holds.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "frames",
        "of"
      ]
    }
  }
}
