{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StepInput",
  "description": "What `step` plays.",
  "type": "object",
  "properties": {
    "frames": {
      "description": "Frames to run after the script with no input.",
      "type": "integer",
      "format": "uint32",
      "default": 0,
      "minimum": 0
    },
    "script": {
      "description": "The steps to play, as `run`'s script.",
      "$ref": "#/$defs/Script",
      "default": {
        "steps": []
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Script": {
      "description": "Steps played in order.",
      "type": "object",
      "properties": {
        "steps": {
          "description": "The steps, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "steps"
      ]
    },
    "Step": {
      "description": "One step of a script, played in the order written.",
      "oneOf": [
        {
          "description": "Each whitespace-separated key chord pressed in one frame and let go\nin the next, in turn (`\"Enter Up Shift+Space\"`).",
          "type": "object",
          "properties": {
            "keys": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "keys"
          ]
        },
        {
          "description": "Each whitespace-separated controller button pressed in one frame\nand let go in the next, in turn (`\"South\"`; `\"East+DpadDown\"`:\nthose buttons together).",
          "type": "object",
          "properties": {
            "pad": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "pad"
          ]
        },
        {
          "description": "The game's action of that name (`Confirm`), pressed by the player's\nprimary key for it, or its primary button if it has no key.",
          "type": "object",
          "properties": {
            "act": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "act"
          ]
        },
        {
          "description": "That many seconds of frames with no input, 60 a second, rounded up.",
          "type": "object",
          "properties": {
            "wait": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "wait"
          ]
        },
        {
          "description": "The crank wound that many degrees in one frame (backwards is\nnegative), as a Playdate front end reports it.",
          "type": "object",
          "properties": {
            "crank": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "crank"
          ]
        },
        {
          "description": "Debug tools and the debug view's channels of these comma-separated\nids turned on from here on (`\"grid,collision\"`; `\"all\"` turns on\nevery channel, offered or not), and the frame drawn again: no frame\npasses (ADR-0084). Played by the Harness only.",
          "type": "object",
          "properties": {
            "debug": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "debug"
          ]
        }
      ]
    }
  }
}
