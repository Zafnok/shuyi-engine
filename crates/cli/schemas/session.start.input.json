{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StartInput",
  "description": "What `start` starts.",
  "type": "object",
  "properties": {
    "project": {
      "description": "The game's folder (the one holding its `shuyi.ron`, or one below\nit), from the server's working folder; the server's own project if\nnone.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "start": {
      "description": "The game's own start options (`start`'s answer lists them), in the\norder given.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/GameArg"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "GameArg": {
      "description": "A game option as given.",
      "type": "object",
      "properties": {
        "flag": {
          "description": "Its flag.",
          "type": "string"
        },
        "value": {
          "description": "Its value, if it takes one.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "flag"
      ]
    }
  }
}
