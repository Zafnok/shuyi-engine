{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer",
  "description": "What an operation answers.",
  "type": "object",
  "properties": {
    "code": {
      "description": "The problem code of its error (`SH1002`), or of its failure when\nit ran and failed on the setup (`doctor`); `shuyi explain <code>`\nprints its page.",
      "type": [
        "string",
        "null"
      ]
    },
    "contract": {
      "description": "The contract's version ([`VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error": {
      "description": "Why it could not run, if it could not.",
      "type": [
        "string",
        "null"
      ]
    },
    "help": {
      "description": "How to fix it, with the code.",
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "description": "What it could not determine, in plain words.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "description": "Whether it passed: nothing found by a check, runs that agree, a\ngame made, a toolchain complete. False too when it could not run.",
      "type": "boolean"
    },
    "op": {
      "description": "The operation.",
      "$ref": "#/$defs/Op"
    },
    "result": {
      "description": "What it found or made; absent when it could not run.",
      "anyOf": [
        {
          "$ref": "#/$defs/ExplainOutput"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "op",
    "ok",
    "limits"
  ],
  "$defs": {
    "Class": {
      "description": "A code's class: what kind of fix it asks for.",
      "oneOf": [
        {
          "description": "The arguments or the input are wrong: change the command.",
          "type": "string",
          "const": "usage"
        },
        {
          "description": "The project file or the toolchain needs fixing: fix it, then run\nthe same command again.",
          "type": "string",
          "const": "setup"
        },
        {
          "description": "A file of the game's content has a problem.",
          "type": "string",
          "const": "content"
        },
        {
          "description": "The operation failed on something else.",
          "type": "string",
          "const": "operation"
        }
      ]
    },
    "ExplainOutput": {
      "description": "What `explain` answers.",
      "type": "object",
      "properties": {
        "entries": {
          "description": "The code asked for, or every code in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Explained"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "entries"
      ]
    },
    "Explained": {
      "description": "One code explained.",
      "type": "object",
      "properties": {
        "class": {
          "description": "Its class, which sets the exit code.",
          "$ref": "#/$defs/Class"
        },
        "code": {
          "description": "The code (`SH2003`).",
          "type": "string"
        },
        "exit_code": {
          "description": "The exit code of an error with it.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "help": {
          "description": "How to fix it, in a line.",
          "type": "string"
        },
        "name": {
          "description": "Its kebab-case name (`missing-file`), as stable as the code.",
          "type": "string"
        },
        "page": {
          "description": "Its page, in Markdown, when one code was asked for.",
          "type": [
            "string",
            "null"
          ]
        },
        "retired": {
          "description": "Whether it is retired: no error gives it any more.",
          "type": "boolean"
        },
        "title": {
          "description": "What went wrong, in a few words.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "class",
        "exit_code",
        "title",
        "help",
        "retired"
      ]
    },
    "Op": {
      "description": "An operation of the contract.",
      "oneOf": [
        {
          "description": "A new game from a template.",
          "type": "string",
          "const": "new"
        },
        {
          "description": "Every error of the game's content.",
          "type": "string",
          "const": "check"
        },
        {
          "description": "A key script played headless.",
          "type": "string",
          "const": "run"
        },
        {
          "description": "The scene on screen.",
          "type": "string",
          "const": "scene"
        },
        {
          "description": "A record replayed.",
          "type": "string",
          "const": "replay"
        },
        {
          "description": "Bots playing the game.",
          "type": "string",
          "const": "bots"
        },
        {
          "description": "Named bots' tries judged against the game's checks.",
          "type": "string",
          "const": "playtest"
        },
        {
          "description": "A file read through the format registry.",
          "type": "string",
          "const": "import"
        },
        {
          "description": "The game's sources baked into a pack.",
          "type": "string",
          "const": "bake"
        },
        {
          "description": "The toolchain checked.",
          "type": "string",
          "const": "doctor"
        },
        {
          "description": "A problem code's page.",
          "type": "string",
          "const": "explain"
        }
      ]
    }
  }
}
