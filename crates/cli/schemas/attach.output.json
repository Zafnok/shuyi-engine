{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer",
  "description": "What an operation answers.",
  "type": "object",
  "properties": {
    "code": {
      "description": "The problem code of its error (`SH1002`), or of its failure when\nit ran and failed on the setup (`doctor`); `shuyi explain <code>`\nprints its page.",
      "type": [
        "string",
        "null"
      ]
    },
    "contract": {
      "description": "The contract's version ([`VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error": {
      "description": "Why it could not run, if it could not.",
      "type": [
        "string",
        "null"
      ]
    },
    "help": {
      "description": "How to fix it, with the code.",
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "description": "What it could not determine, in plain words.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "description": "Whether it passed: nothing found by a check, runs that agree, a\ngame made, a toolchain complete. False too when it could not run.",
      "type": "boolean"
    },
    "op": {
      "description": "The operation.",
      "$ref": "#/$defs/Op"
    },
    "result": {
      "description": "What it found or made; absent when it could not run.",
      "anyOf": [
        {
          "$ref": "#/$defs/AttachOutput"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "op",
    "ok",
    "limits"
  ],
  "$defs": {
    "AttachLogEntry": {
      "description": "One line of the build's log, with its number.",
      "type": "object",
      "properties": {
        "category": {
          "description": "What it is about: `assets`, `audio`, `input`, `screens`, `storage`,\n`platform` or `game`.",
          "type": "string"
        },
        "frame": {
          "description": "The frame it was given in (frames count from 1).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "level": {
          "description": "How serious it is: `error`, `warn`, `info` or `debug`.",
          "type": "string"
        },
        "seq": {
          "description": "Its number in the build's log: lines are numbered from 0 as they\nare logged.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "text": {
          "description": "What it says, in English.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "seq",
        "frame",
        "level",
        "category",
        "text"
      ]
    },
    "AttachOutput": {
      "description": "What `attach` saw.",
      "type": "object",
      "properties": {
        "focused": {
          "description": "Whether its window has the player's attention.",
          "type": "boolean"
        },
        "frame": {
          "description": "The frame, in the snapshot text format; empty while the game\nisn't running.",
          "type": "string"
        },
        "frames": {
          "description": "The frames the build has run since it started.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "game": {
          "description": "The game: its window's title.",
          "type": "string"
        },
        "link": {
          "description": "The link's version both ends speak.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "log": {
          "description": "The build's log lines numbered `log_since` or more, oldest first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttachLogEntry"
          }
        },
        "log_next": {
          "description": "The number the build's next log line gets: the next `log_since`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "phase": {
          "description": "Where the game is: `loading` (its card shows), `running` or\n`failed` (its load failed; the errors show).",
          "type": "string"
        },
        "quit": {
          "description": "Whether the game has quit.",
          "type": "boolean"
        },
        "screens": {
          "description": "The open screens, bottom first.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "screenshot": {
          "description": "The window's picture, if asked for.",
          "anyOf": [
            {
              "$ref": "#/$defs/AttachScreenshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "suspended": {
          "description": "Whether the system has suspended the build.",
          "type": "boolean"
        },
        "top_screen": {
          "description": "The top screen's name; empty with none open.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "link",
        "game",
        "frames",
        "phase",
        "top_screen",
        "screens",
        "suspended",
        "focused",
        "quit",
        "frame",
        "log",
        "log_next"
      ]
    },
    "AttachScreenshot": {
      "description": "The window's picture, as written.",
      "type": "object",
      "properties": {
        "height": {
          "description": "Its height in pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "description": "The file, as given.",
          "type": "string"
        },
        "width": {
          "description": "Its width in pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "width",
        "height"
      ]
    },
    "Op": {
      "description": "An operation of the contract.",
      "oneOf": [
        {
          "description": "A new game from a template.",
          "type": "string",
          "const": "new"
        },
        {
          "description": "Every error of the game's content.",
          "type": "string",
          "const": "check"
        },
        {
          "description": "What is wrong with the shape of the game's code.",
          "type": "string",
          "const": "lint"
        },
        {
          "description": "The catalog of modules, and the game's.",
          "type": "string",
          "const": "modules"
        },
        {
          "description": "A module turned on.",
          "type": "string",
          "const": "add"
        },
        {
          "description": "A key script played headless.",
          "type": "string",
          "const": "run"
        },
        {
          "description": "The scene on screen.",
          "type": "string",
          "const": "scene"
        },
        {
          "description": "A record replayed.",
          "type": "string",
          "const": "replay"
        },
        {
          "description": "Bots playing the game.",
          "type": "string",
          "const": "bots"
        },
        {
          "description": "Named bots' tries judged against the game's checks.",
          "type": "string",
          "const": "playtest"
        },
        {
          "description": "A stage changed until the game's named bots land in their bands.",
          "type": "string",
          "const": "autobalance"
        },
        {
          "description": "A file read through the format registry.",
          "type": "string",
          "const": "import"
        },
        {
          "description": "The game's sources baked into a pack.",
          "type": "string",
          "const": "bake"
        },
        {
          "description": "The toolchain checked.",
          "type": "string",
          "const": "doctor"
        },
        {
          "description": "A problem code's page.",
          "type": "string",
          "const": "explain"
        },
        {
          "description": "A running build reached over the live link.",
          "type": "string",
          "const": "attach"
        },
        {
          "description": "The MCP session's game started headless.",
          "type": "string",
          "const": "start"
        },
        {
          "description": "The MCP session's game played on: a script, then idle frames.",
          "type": "string",
          "const": "step"
        },
        {
          "description": "A picture of the MCP session's frame.",
          "type": "string",
          "const": "frame_png"
        },
        {
          "description": "What happened in the MCP session's game.",
          "type": "string",
          "const": "events"
        },
        {
          "description": "The MCP session's game started again.",
          "type": "string",
          "const": "reset"
        },
        {
          "description": "The MCP session's game stopped.",
          "type": "string",
          "const": "stop"
        }
      ]
    }
  }
}
