{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer",
  "description": "What an operation answers.",
  "type": "object",
  "properties": {
    "code": {
      "description": "The problem code of its error (`SH1002`), or of its failure when\nit ran and failed on the setup (`doctor`); `shuyi explain <code>`\nprints its page.",
      "type": [
        "string",
        "null"
      ]
    },
    "contract": {
      "description": "The contract's version ([`VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error": {
      "description": "Why it could not run, if it could not.",
      "type": [
        "string",
        "null"
      ]
    },
    "help": {
      "description": "How to fix it, with the code.",
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "description": "What it could not determine, in plain words.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "description": "Whether it passed: nothing found by a check, runs that agree, a\ngame made, a toolchain complete. False too when it could not run.",
      "type": "boolean"
    },
    "op": {
      "description": "The operation.",
      "type": "string",
      "const": "frame_png"
    },
    "result": {
      "description": "What it found or made; absent when it could not run.",
      "anyOf": [
        {
          "$ref": "#/$defs/FramePngOutput"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "op",
    "ok",
    "limits"
  ],
  "$defs": {
    "FramePngCell": {
      "description": "A cell of `frame_png`'s sheet.",
      "type": "object",
      "properties": {
        "frame": {
          "description": "The frames run in all when it was painted.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "millis": {
          "description": "Its time since the first, in whole milliseconds, as its label\nsays.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "top_screen": {
          "description": "The top screen's name then.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "millis",
        "frame",
        "top_screen"
      ]
    },
    "FramePngOutput": {
      "description": "What `frame_png` painted (the picture itself is the tool's image).",
      "type": "object",
      "properties": {
        "cells": {
          "description": "With `count`, each cell of the sheet, in order; left out for one\npicture.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FramePngCell"
          }
        },
        "frames": {
          "description": "The frames run in all.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "description": "Its height in pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "top_screen": {
          "description": "The top screen's name.",
          "type": "string"
        },
        "width": {
          "description": "The picture's width in pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "frames",
        "top_screen",
        "width",
        "height"
      ]
    }
  }
}
