{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer",
  "description": "What an operation answers.",
  "type": "object",
  "properties": {
    "code": {
      "description": "The problem code of its error (`SH1002`), or of its failure when\nit ran and failed on the setup (`doctor`); `shuyi explain <code>`\nprints its page.",
      "type": [
        "string",
        "null"
      ]
    },
    "contract": {
      "description": "The contract's version ([`VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error": {
      "description": "Why it could not run, if it could not.",
      "type": [
        "string",
        "null"
      ]
    },
    "help": {
      "description": "How to fix it, with the code.",
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "description": "What it could not determine, in plain words.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "description": "Whether it passed: nothing found by a check, runs that agree, a\ngame made, a toolchain complete. False too when it could not run.",
      "type": "boolean"
    },
    "op": {
      "description": "The operation.",
      "$ref": "#/$defs/Op"
    },
    "result": {
      "description": "What it found or made; absent when it could not run.",
      "anyOf": [
        {
          "$ref": "#/$defs/ImportOutput"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "op",
    "ok",
    "limits"
  ],
  "$defs": {
    "ImportOutput": {
      "description": "What `import` found.",
      "type": "object",
      "properties": {
        "errors": {
          "description": "When it reads as none: the errors of the kinds that claim it.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Problem"
          }
        },
        "file": {
          "description": "The file.",
          "type": "string"
        },
        "read_as": {
          "description": "Every kind it reads as.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Imported"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "read_as",
        "errors"
      ]
    },
    "Imported": {
      "description": "The file read as one kind.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "The kind (`palette`).",
          "type": "string"
        },
        "summary": {
          "description": "What was read, in a line (`palette: 21 colors`).",
          "type": "string"
        },
        "text": {
          "description": "With `print`, the asset: in our text format if the kind has a\nwriter, else as read, in Rust's debug form.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "summary"
      ]
    },
    "Op": {
      "description": "An operation of the contract.",
      "oneOf": [
        {
          "description": "A new game from a template.",
          "type": "string",
          "const": "new"
        },
        {
          "description": "Every error of the game's content.",
          "type": "string",
          "const": "check"
        },
        {
          "description": "What is wrong with the shape of the game's code.",
          "type": "string",
          "const": "lint"
        },
        {
          "description": "A key script played headless.",
          "type": "string",
          "const": "run"
        },
        {
          "description": "The scene on screen.",
          "type": "string",
          "const": "scene"
        },
        {
          "description": "A record replayed.",
          "type": "string",
          "const": "replay"
        },
        {
          "description": "Bots playing the game.",
          "type": "string",
          "const": "bots"
        },
        {
          "description": "Named bots' tries judged against the game's checks.",
          "type": "string",
          "const": "playtest"
        },
        {
          "description": "A stage changed until the game's named bots land in their bands.",
          "type": "string",
          "const": "autobalance"
        },
        {
          "description": "A file read through the format registry.",
          "type": "string",
          "const": "import"
        },
        {
          "description": "The game's sources baked into a pack.",
          "type": "string",
          "const": "bake"
        },
        {
          "description": "The toolchain checked.",
          "type": "string",
          "const": "doctor"
        },
        {
          "description": "A problem code's page.",
          "type": "string",
          "const": "explain"
        },
        {
          "description": "The MCP session's game started headless.",
          "type": "string",
          "const": "start"
        },
        {
          "description": "The MCP session's game played on: a script, then idle frames.",
          "type": "string",
          "const": "step"
        },
        {
          "description": "A picture of the MCP session's frame.",
          "type": "string",
          "const": "frame_png"
        },
        {
          "description": "What happened in the MCP session's game.",
          "type": "string",
          "const": "events"
        },
        {
          "description": "The MCP session's game started again.",
          "type": "string",
          "const": "reset"
        },
        {
          "description": "The MCP session's game stopped.",
          "type": "string",
          "const": "stop"
        }
      ]
    },
    "Problem": {
      "description": "A problem in a file: what a validator found, with where.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Its problem code (`SH2001`), if its class has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "column": {
          "description": "Its 1-based column, if known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "file": {
          "description": "The file, as the game shows it (`files/stage.map`).",
          "type": "string"
        },
        "help": {
          "description": "How to fix it, with the code.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "Its 1-based line, if known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "message": {
          "description": "What is wrong.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "message"
      ]
    }
  }
}
