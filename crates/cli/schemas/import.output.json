{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer",
  "description": "What an operation answers.",
  "type": "object",
  "properties": {
    "contract": {
      "description": "The contract's version ([`VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error": {
      "description": "Why it could not run, if it could not.",
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "description": "What it could not determine, in plain words.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "description": "Whether it passed: nothing found by a check, runs that agree, a\ngame made, a toolchain complete. False too when it could not run.",
      "type": "boolean"
    },
    "op": {
      "description": "The operation.",
      "$ref": "#/$defs/Op"
    },
    "result": {
      "description": "What it found or made; absent when it could not run.",
      "anyOf": [
        {
          "$ref": "#/$defs/ImportOutput"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "op",
    "ok",
    "limits"
  ],
  "$defs": {
    "ImportOutput": {
      "description": "What `import` found.",
      "type": "object",
      "properties": {
        "errors": {
          "description": "When it reads as none: the errors of the kinds that claim it.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Problem"
          }
        },
        "file": {
          "description": "The file.",
          "type": "string"
        },
        "read_as": {
          "description": "Every kind it reads as.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Imported"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "read_as",
        "errors"
      ]
    },
    "Imported": {
      "description": "The file read as one kind.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "The kind (`palette`).",
          "type": "string"
        },
        "summary": {
          "description": "What was read, in a line (`palette: 21 colors`).",
          "type": "string"
        },
        "text": {
          "description": "With `print`, the asset: in our text format if the kind has a\nwriter, else as read, in Rust's debug form.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "summary"
      ]
    },
    "Op": {
      "description": "An operation of the contract.",
      "oneOf": [
        {
          "description": "A new game from a template.",
          "type": "string",
          "const": "new"
        },
        {
          "description": "Every error of the game's content.",
          "type": "string",
          "const": "check"
        },
        {
          "description": "A key script played headless.",
          "type": "string",
          "const": "run"
        },
        {
          "description": "The scene on screen.",
          "type": "string",
          "const": "scene"
        },
        {
          "description": "A record replayed.",
          "type": "string",
          "const": "replay"
        },
        {
          "description": "Bots playing the game.",
          "type": "string",
          "const": "bots"
        },
        {
          "description": "Named bots' tries judged against the game's checks.",
          "type": "string",
          "const": "playtest"
        },
        {
          "description": "A file read through the format registry.",
          "type": "string",
          "const": "import"
        },
        {
          "description": "The game's sources baked into a pack.",
          "type": "string",
          "const": "bake"
        },
        {
          "description": "The toolchain checked.",
          "type": "string",
          "const": "doctor"
        }
      ]
    },
    "Problem": {
      "description": "A problem in a file: what a validator found, with where.",
      "type": "object",
      "properties": {
        "column": {
          "description": "Its 1-based column, if known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "file": {
          "description": "The file, as the game shows it (`files/stage.map`).",
          "type": "string"
        },
        "line": {
          "description": "Its 1-based line, if known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "message": {
          "description": "What is wrong.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "message"
      ]
    }
  }
}
