{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer",
  "description": "What an operation answers.",
  "type": "object",
  "properties": {
    "code": {
      "description": "The problem code of its error (`SH1002`), or of its failure when\nit ran and failed on the setup (`doctor`); `shuyi explain <code>`\nprints its page.",
      "type": [
        "string",
        "null"
      ]
    },
    "contract": {
      "description": "The contract's version ([`VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error": {
      "description": "Why it could not run, if it could not.",
      "type": [
        "string",
        "null"
      ]
    },
    "help": {
      "description": "How to fix it, with the code.",
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "description": "What it could not determine, in plain words.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "description": "Whether it passed: nothing found by a check, runs that agree, a\ngame made, a toolchain complete. False too when it could not run.",
      "type": "boolean"
    },
    "op": {
      "description": "The operation.",
      "type": "string",
      "const": "bake"
    },
    "result": {
      "description": "What it found or made; absent when it could not run.",
      "anyOf": [
        {
          "$ref": "#/$defs/BakeOutput"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "op",
    "ok",
    "limits"
  ],
  "$defs": {
    "BakeOutput": {
      "description": "What `bake` made.",
      "type": "object",
      "properties": {
        "errors": {
          "description": "Every error of the sources: the pack is made only when there is\nnone.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Problem"
          }
        },
        "pack": {
          "description": "The pack, if it was made.",
          "anyOf": [
            {
              "$ref": "#/$defs/PackMade"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "errors"
      ]
    },
    "PackMade": {
      "description": "A pack `bake` wrote.",
      "type": "object",
      "properties": {
        "bake_us": {
          "description": "How long baking took, in microseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "baked": {
          "description": "How many of them hold baked assets; the others hold their own\nbytes.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "file": {
          "description": "Its file, from the project's root.",
          "type": "string"
        },
        "files": {
          "description": "The files in it.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "kinds": {
          "description": "The kinds baked, by name.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "load_pack_us": {
          "description": "How long opening the pack and reading every baked asset from it\ntook, in microseconds: the fastest of a few runs.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "load_sources_us": {
          "description": "How long reading every baked asset from its source took, in\nmicroseconds: the fastest of a few runs.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "pack_bytes": {
          "description": "The pack's bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "source_bytes": {
          "description": "The sources' bytes, added up.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "target": {
          "description": "The target it was baked for.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "files",
        "baked",
        "kinds",
        "source_bytes",
        "pack_bytes",
        "bake_us",
        "load_sources_us",
        "load_pack_us"
      ]
    },
    "Problem": {
      "description": "A problem in a file: what a validator found, with where.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Its problem code (`SH2001`), if its class has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "column": {
          "description": "Its 1-based column, if known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "file": {
          "description": "The file, as the game shows it (`files/stage.map`).",
          "type": "string"
        },
        "help": {
          "description": "How to fix it, with the code.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "Its 1-based line, if known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "message": {
          "description": "What is wrong.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "message"
      ]
    }
  }
}
