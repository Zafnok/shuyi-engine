{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer",
  "description": "What an operation answers.",
  "type": "object",
  "properties": {
    "code": {
      "description": "The problem code of its error (`SH1002`), or of its failure when\nit ran and failed on the setup (`doctor`); `shuyi explain <code>`\nprints its page.",
      "type": [
        "string",
        "null"
      ]
    },
    "contract": {
      "description": "The contract's version ([`VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error": {
      "description": "Why it could not run, if it could not.",
      "type": [
        "string",
        "null"
      ]
    },
    "help": {
      "description": "How to fix it, with the code.",
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "description": "What it could not determine, in plain words.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "description": "Whether it passed: nothing found by a check, runs that agree, a\ngame made, a toolchain complete. False too when it could not run.",
      "type": "boolean"
    },
    "op": {
      "description": "The operation.",
      "type": "string",
      "const": "doctor"
    },
    "result": {
      "description": "What it found or made; absent when it could not run.",
      "anyOf": [
        {
          "$ref": "#/$defs/DoctorOutput"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "op",
    "ok",
    "limits"
  ],
  "$defs": {
    "Check": {
      "description": "One check.",
      "type": "object",
      "properties": {
        "found": {
          "description": "What it found, if anything.",
          "type": [
            "string",
            "null"
          ]
        },
        "help": {
          "description": "How to fix it, if it failed.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "What it checks (`rust`, `wasm-target`…).",
          "type": "string"
        },
        "ok": {
          "description": "Whether it passed.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "ok"
      ]
    },
    "DoctorOutput": {
      "description": "What `doctor` found.",
      "type": "object",
      "properties": {
        "checks": {
          "description": "Every check, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Check"
          }
        },
        "host": {
          "description": "The Rust host's target triple, if Rust was found.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "checks"
      ]
    }
  }
}
