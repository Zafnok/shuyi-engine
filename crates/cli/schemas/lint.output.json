{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer",
  "description": "What an operation answers.",
  "type": "object",
  "properties": {
    "code": {
      "description": "The problem code of its error (`SH1002`), or of its failure when\nit ran and failed on the setup (`doctor`); `shuyi explain <code>`\nprints its page.",
      "type": [
        "string",
        "null"
      ]
    },
    "contract": {
      "description": "The contract's version ([`VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error": {
      "description": "Why it could not run, if it could not.",
      "type": [
        "string",
        "null"
      ]
    },
    "help": {
      "description": "How to fix it, with the code.",
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "description": "What it could not determine, in plain words.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "description": "Whether it passed: nothing found by a check, runs that agree, a\ngame made, a toolchain complete. False too when it could not run.",
      "type": "boolean"
    },
    "op": {
      "description": "The operation.",
      "$ref": "#/$defs/Op"
    },
    "result": {
      "description": "What it found or made; absent when it could not run.",
      "anyOf": [
        {
          "$ref": "#/$defs/LintOutput"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "op",
    "ok",
    "limits"
  ],
  "$defs": {
    "Finding": {
      "description": "One thing wrong, with where.",
      "type": "object",
      "properties": {
        "check": {
          "description": "The check that found it.",
          "$ref": "#/$defs/LintCheck"
        },
        "code": {
          "description": "Its problem code (`SH2101`).",
          "type": "string"
        },
        "column": {
          "description": "Its 1-based column, if known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "command": {
          "description": "A command that shows more: for a dependency, the `cargo tree -i`\nthat shows the way in.",
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "description": "The file, from the project's root (`crates/rules/src/lib.rs`).",
          "type": "string"
        },
        "help": {
          "description": "How to fix it, with the code.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "Its 1-based line, if known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "message": {
          "description": "What is wrong, and for the fence, what to use instead.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "check",
        "file",
        "message",
        "code"
      ]
    },
    "LintCheck": {
      "description": "Which check found a finding.",
      "oneOf": [
        {
          "description": "`check-keys`: a key named in code or text.",
          "type": "string",
          "const": "check-keys"
        },
        {
          "description": "`check-text`: screen text as a literal, or a data name read.",
          "type": "string",
          "const": "check-text"
        },
        {
          "description": "The rules crate's clippy fence.",
          "type": "string",
          "const": "rules-fence"
        },
        {
          "description": "The rules crate's dependencies.",
          "type": "string",
          "const": "rules-layers"
        }
      ]
    },
    "LintOutput": {
      "description": "What `lint` found.",
      "type": "object",
      "properties": {
        "findings": {
          "description": "Every finding: `check-keys`', `check-text`'s, the fence's, then the\nlayers'.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "findings"
      ]
    },
    "Op": {
      "description": "An operation of the contract.",
      "oneOf": [
        {
          "description": "A new game from a template.",
          "type": "string",
          "const": "new"
        },
        {
          "description": "Every error of the game's content.",
          "type": "string",
          "const": "check"
        },
        {
          "description": "What is wrong with the shape of the game's code.",
          "type": "string",
          "const": "lint"
        },
        {
          "description": "The catalog of modules, and the game's.",
          "type": "string",
          "const": "modules"
        },
        {
          "description": "A module turned on.",
          "type": "string",
          "const": "add"
        },
        {
          "description": "A key script played headless.",
          "type": "string",
          "const": "run"
        },
        {
          "description": "The scene on screen.",
          "type": "string",
          "const": "scene"
        },
        {
          "description": "A record replayed.",
          "type": "string",
          "const": "replay"
        },
        {
          "description": "Bots playing the game.",
          "type": "string",
          "const": "bots"
        },
        {
          "description": "Named bots' tries judged against the game's checks.",
          "type": "string",
          "const": "playtest"
        },
        {
          "description": "A stage changed until the game's named bots land in their bands.",
          "type": "string",
          "const": "autobalance"
        },
        {
          "description": "A file read through the format registry.",
          "type": "string",
          "const": "import"
        },
        {
          "description": "The game's sources baked into a pack.",
          "type": "string",
          "const": "bake"
        },
        {
          "description": "The toolchain checked.",
          "type": "string",
          "const": "doctor"
        },
        {
          "description": "A problem code's page.",
          "type": "string",
          "const": "explain"
        },
        {
          "description": "The MCP session's game started headless.",
          "type": "string",
          "const": "start"
        },
        {
          "description": "The MCP session's game played on: a script, then idle frames.",
          "type": "string",
          "const": "step"
        },
        {
          "description": "A picture of the MCP session's frame.",
          "type": "string",
          "const": "frame_png"
        },
        {
          "description": "What happened in the MCP session's game.",
          "type": "string",
          "const": "events"
        },
        {
          "description": "The MCP session's game started again.",
          "type": "string",
          "const": "reset"
        },
        {
          "description": "The MCP session's game stopped.",
          "type": "string",
          "const": "stop"
        }
      ]
    }
  }
}
