{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NewInput",
  "description": "What `new` makes.",
  "type": "object",
  "properties": {
    "dir": {
      "description": "The new game's folder, from the working folder: made if missing,\nand refused unless empty.",
      "type": "string"
    },
    "engine": {
      "description": "Where it gets the engine from.",
      "$ref": "#/$defs/Engine",
      "default": {
        "from": "main"
      }
    },
    "name": {
      "description": "The game's name; the folder's name if none.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "template": {
      "description": "The template.",
      "$ref": "#/$defs/Template"
    }
  },
  "additionalProperties": false,
  "required": [
    "template",
    "dir"
  ],
  "$defs": {
    "Engine": {
      "description": "Where the new game gets the engine from.",
      "oneOf": [
        {
          "description": "The engine's repository at its `main` branch.",
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "const": "main"
            }
          },
          "additionalProperties": false,
          "required": [
            "from"
          ]
        },
        {
          "description": "The engine's repository at a commit.",
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "const": "rev"
            },
            "rev": {
              "description": "The commit, 7 to 40 hex digits.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "from",
            "rev"
          ]
        },
        {
          "description": "A checkout of the engine on this machine.",
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "const": "path"
            },
            "path": {
              "description": "Its folder (the one holding `crates/`).",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "from",
            "path"
          ]
        }
      ]
    },
    "Template": {
      "description": "A template of the engine's.",
      "oneOf": [
        {
          "description": "A turn-based grid stage: a rules crate over `TurnRules` and a game\ncrate with one stage screen, a bot, records, and every tool of the\ncontract wired.",
          "type": "string",
          "const": "grid"
        },
        {
          "description": "One screen and nothing else.",
          "type": "string",
          "const": "blank"
        }
      ]
    }
  }
}
