{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer",
  "description": "What an operation answers.",
  "type": "object",
  "properties": {
    "code": {
      "description": "The problem code of its error (`SH1002`), or of its failure when\nit ran and failed on the setup (`doctor`); `shuyi explain <code>`\nprints its page.",
      "type": [
        "string",
        "null"
      ]
    },
    "contract": {
      "description": "The contract's version ([`VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error": {
      "description": "Why it could not run, if it could not.",
      "type": [
        "string",
        "null"
      ]
    },
    "help": {
      "description": "How to fix it, with the code.",
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "description": "What it could not determine, in plain words.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "description": "Whether it passed: nothing found by a check, runs that agree, a\ngame made, a toolchain complete. False too when it could not run.",
      "type": "boolean"
    },
    "op": {
      "description": "The operation.",
      "$ref": "#/$defs/Op"
    },
    "result": {
      "description": "What it found or made; absent when it could not run.",
      "anyOf": [
        {
          "$ref": "#/$defs/NewOutput"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "op",
    "ok",
    "limits"
  ],
  "$defs": {
    "Answers": {
      "description": "The answers a game picked: by question id, the ids of its answers, as\n`answers.ron` holds them (`{ \"perspective\": [\"top-down-grid\"] }`).",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "NewOutput": {
      "description": "What `new` made.",
      "type": "object",
      "properties": {
        "answers": {
          "description": "The answers it was made for, each question left out at its\ndefault.",
          "$ref": "#/$defs/Answers"
        },
        "crate_name": {
          "description": "Its crate's name.",
          "type": "string"
        },
        "dir": {
          "description": "The game's folder, as given.",
          "type": "string"
        },
        "files": {
          "description": "The files made, from its folder, `/`-separated, in order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modules": {
          "description": "The engine's modules turned on, by crate.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "description": "The game's name.",
          "type": "string"
        },
        "overwritten": {
          "description": "The files that were there already and were written over (with\n`force`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parts": {
          "description": "The template's parts it was made of, in order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stages": {
          "description": "Its stages, in order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targets": {
          "description": "The targets it ships on.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "template": {
          "description": "The template's id (`shuyi-default`).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "dir",
        "name",
        "crate_name",
        "template",
        "answers",
        "parts",
        "files",
        "overwritten",
        "modules",
        "targets",
        "stages"
      ]
    },
    "Op": {
      "description": "An operation of the contract.",
      "oneOf": [
        {
          "description": "A new game from a template.",
          "type": "string",
          "const": "new"
        },
        {
          "description": "Every error of the game's content.",
          "type": "string",
          "const": "check"
        },
        {
          "description": "What is wrong with the shape of the game's code.",
          "type": "string",
          "const": "lint"
        },
        {
          "description": "The catalog of modules, and the game's.",
          "type": "string",
          "const": "modules"
        },
        {
          "description": "A module turned on.",
          "type": "string",
          "const": "add"
        },
        {
          "description": "A key script played headless.",
          "type": "string",
          "const": "run"
        },
        {
          "description": "The scene on screen.",
          "type": "string",
          "const": "scene"
        },
        {
          "description": "A record replayed.",
          "type": "string",
          "const": "replay"
        },
        {
          "description": "Bots playing the game.",
          "type": "string",
          "const": "bots"
        },
        {
          "description": "Named bots' tries judged against the game's checks.",
          "type": "string",
          "const": "playtest"
        },
        {
          "description": "A stage changed until the game's named bots land in their bands.",
          "type": "string",
          "const": "autobalance"
        },
        {
          "description": "A file read through the format registry.",
          "type": "string",
          "const": "import"
        },
        {
          "description": "The game's sources baked into a pack.",
          "type": "string",
          "const": "bake"
        },
        {
          "description": "The toolchain checked.",
          "type": "string",
          "const": "doctor"
        },
        {
          "description": "A problem code's page.",
          "type": "string",
          "const": "explain"
        },
        {
          "description": "The MCP session's game started headless.",
          "type": "string",
          "const": "start"
        },
        {
          "description": "The MCP session's game played on: a script, then idle frames.",
          "type": "string",
          "const": "step"
        },
        {
          "description": "A picture of the MCP session's frame.",
          "type": "string",
          "const": "frame_png"
        },
        {
          "description": "What happened in the MCP session's game.",
          "type": "string",
          "const": "events"
        },
        {
          "description": "The MCP session's game started again.",
          "type": "string",
          "const": "reset"
        },
        {
          "description": "The MCP session's game stopped.",
          "type": "string",
          "const": "stop"
        }
      ]
    }
  }
}
