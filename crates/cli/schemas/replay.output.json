{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer",
  "description": "What an operation answers.",
  "type": "object",
  "properties": {
    "code": {
      "description": "The problem code of its error (`SH1002`), or of its failure when\nit ran and failed on the setup (`doctor`); `shuyi explain <code>`\nprints its page.",
      "type": [
        "string",
        "null"
      ]
    },
    "contract": {
      "description": "The contract's version ([`VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error": {
      "description": "Why it could not run, if it could not.",
      "type": [
        "string",
        "null"
      ]
    },
    "help": {
      "description": "How to fix it, with the code.",
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "description": "What it could not determine, in plain words.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "description": "Whether it passed: nothing found by a check, runs that agree, a\ngame made, a toolchain complete. False too when it could not run.",
      "type": "boolean"
    },
    "op": {
      "description": "The operation.",
      "$ref": "#/$defs/Op"
    },
    "result": {
      "description": "What it found or made; absent when it could not run.",
      "anyOf": [
        {
          "$ref": "#/$defs/ReplayOutput"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "op",
    "ok",
    "limits"
  ],
  "$defs": {
    "Difference": {
      "description": "Where two runs part.",
      "type": "object",
      "properties": {
        "hashes": {
          "description": "Each run's hash at that step; none for a run that has no such\nstep.",
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "step": {
          "description": "The first step whose hashes differ, or that only one run has.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "step",
        "hashes"
      ]
    },
    "Op": {
      "description": "An operation of the contract.",
      "oneOf": [
        {
          "description": "A new game from a template.",
          "type": "string",
          "const": "new"
        },
        {
          "description": "Every error of the game's content.",
          "type": "string",
          "const": "check"
        },
        {
          "description": "What is wrong with the shape of the game's code.",
          "type": "string",
          "const": "lint"
        },
        {
          "description": "A key script played headless.",
          "type": "string",
          "const": "run"
        },
        {
          "description": "The scene on screen.",
          "type": "string",
          "const": "scene"
        },
        {
          "description": "A record replayed.",
          "type": "string",
          "const": "replay"
        },
        {
          "description": "Bots playing the game.",
          "type": "string",
          "const": "bots"
        },
        {
          "description": "Named bots' tries judged against the game's checks.",
          "type": "string",
          "const": "playtest"
        },
        {
          "description": "A stage changed until the game's named bots land in their bands.",
          "type": "string",
          "const": "autobalance"
        },
        {
          "description": "A file read through the format registry.",
          "type": "string",
          "const": "import"
        },
        {
          "description": "The game's sources baked into a pack.",
          "type": "string",
          "const": "bake"
        },
        {
          "description": "The toolchain checked.",
          "type": "string",
          "const": "doctor"
        },
        {
          "description": "A problem code's page.",
          "type": "string",
          "const": "explain"
        },
        {
          "description": "The MCP session's game started headless.",
          "type": "string",
          "const": "start"
        },
        {
          "description": "The MCP session's game played on: a script, then idle frames.",
          "type": "string",
          "const": "step"
        },
        {
          "description": "A picture of the MCP session's frame.",
          "type": "string",
          "const": "frame_png"
        },
        {
          "description": "What happened in the MCP session's game.",
          "type": "string",
          "const": "events"
        },
        {
          "description": "The MCP session's game started again.",
          "type": "string",
          "const": "reset"
        },
        {
          "description": "The MCP session's game stopped.",
          "type": "string",
          "const": "stop"
        }
      ]
    },
    "ReplayOutput": {
      "description": "What `replay` found.",
      "type": "object",
      "properties": {
        "first_difference": {
          "description": "The first step where they differ, if they do.",
          "anyOf": [
            {
              "$ref": "#/$defs/Difference"
            },
            {
              "type": "null"
            }
          ]
        },
        "runs": {
          "description": "The two runs.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReplayRun"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "runs"
      ]
    },
    "ReplayRun": {
      "description": "One run of a record.",
      "type": "object",
      "properties": {
        "outcome": {
          "description": "How the game ended, in the game's words, if it did.",
          "type": [
            "string",
            "null"
          ]
        },
        "record": {
          "description": "The record's file.",
          "type": "string"
        },
        "steps": {
          "description": "Step 0 (the state it starts in), then one step per command.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReplayStep"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "record",
        "steps"
      ]
    },
    "ReplayStep": {
      "description": "One step of a run: the state after a command.",
      "type": "object",
      "properties": {
        "command": {
          "description": "The command, in the game's words; none at step 0.",
          "type": [
            "string",
            "null"
          ]
        },
        "events": {
          "description": "What it did, in the game's words.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hash": {
          "description": "The state's hash after it (sixteen hex digits).",
          "type": "string"
        },
        "refused": {
          "description": "Why the rules refused it, if they did (the state didn't change).",
          "type": [
            "string",
            "null"
          ]
        },
        "step": {
          "description": "The step: 0 before any command, then the command's place from 1.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "step",
        "hash",
        "events"
      ]
    }
  }
}
