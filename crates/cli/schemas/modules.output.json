{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer",
  "description": "What an operation answers.",
  "type": "object",
  "properties": {
    "code": {
      "description": "The problem code of its error (`SH1002`), or of its failure when\nit ran and failed on the setup (`doctor`); `shuyi explain <code>`\nprints its page.",
      "type": [
        "string",
        "null"
      ]
    },
    "contract": {
      "description": "The contract's version ([`VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error": {
      "description": "Why it could not run, if it could not.",
      "type": [
        "string",
        "null"
      ]
    },
    "help": {
      "description": "How to fix it, with the code.",
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "description": "What it could not determine, in plain words.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "description": "Whether it passed: nothing found by a check, runs that agree, a\ngame made, a toolchain complete. False too when it could not run.",
      "type": "boolean"
    },
    "op": {
      "description": "The operation.",
      "type": "string",
      "const": "modules"
    },
    "result": {
      "description": "What it found or made; absent when it could not run.",
      "anyOf": [
        {
          "$ref": "#/$defs/ModulesOutput"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "op",
    "ok",
    "limits"
  ],
  "$defs": {
    "Answered": {
      "description": "One concern a module answers, and its answer.",
      "type": "object",
      "properties": {
        "answer": {
          "description": "The answer's id under it.",
          "type": "string"
        },
        "concern": {
          "description": "The concern's id, in `docs/modules.ron`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "concern",
        "answer"
      ]
    },
    "Choice": {
      "description": "One answer to a concern.",
      "type": "object",
      "properties": {
        "by": {
          "description": "Who answers it: `default` (a kit of the default engine) or a\nmodule's crate (`shuyi-physics`).",
          "type": "string"
        },
        "id": {
          "description": "What a module's metadata names (`rigid-body`).",
          "type": "string"
        },
        "name": {
          "description": "How the catalog says it (`rigid-body physics`).",
          "type": "string"
        },
        "status": {
          "description": "Whether it is built.",
          "$ref": "#/$defs/Status"
        },
        "tickets": {
          "description": "The tickets that build it.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "by",
        "status",
        "tickets"
      ]
    },
    "Concern": {
      "description": "A question every game answers one way or another.",
      "type": "object",
      "properties": {
        "alternatives": {
          "description": "Whether its answers are alternatives, never driving the same\nthing in one stage, so that two modules answering it name each\nother; `false` when they can share a stage.",
          "type": "boolean"
        },
        "answers": {
          "description": "Its answers.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Choice"
          }
        },
        "id": {
          "description": "What a module's metadata names (`bodies`).",
          "type": "string"
        },
        "name": {
          "description": "How the catalog says it (`Bodies and motion`).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "alternatives",
        "answers"
      ]
    },
    "ModuleEntry": {
      "description": "A module the engine builds.",
      "type": "object",
      "properties": {
        "feature": {
          "description": "Its feature of the `shuyi` crate (`physics`).",
          "type": "string"
        },
        "info": {
          "description": "Its metadata: what it answers, serves and sits beside.",
          "$ref": "#/$defs/ModuleInfo"
        },
        "name": {
          "description": "Its crate (`shuyi-physics`).",
          "type": "string"
        },
        "on": {
          "description": "Whether the game has it on.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "feature",
        "on",
        "info"
      ]
    },
    "ModuleInfo": {
      "description": "A module's `[package.metadata.shuyi]` (ADR-0009 §4): what it answers,\nwhat it is built for, and what it sits beside.",
      "type": "object",
      "properties": {
        "alternatives": {
          "description": "The modules that answer one of its concerns another way, by crate.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "answers": {
          "description": "The concerns it answers, and how: one module may answer several\n(`[{ concern = \"bodies\", answer = \"rigid-body\" }]`).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Answered"
          }
        },
        "formats": {
          "description": "The function a game's `formats()` calls to add the module's\nformats, if it has any (`shuyi_crawl::formats`).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "serves": {
          "description": "The directions it is built for (`side-view`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "works_with": {
          "description": "The modules it has been tested beside in one stage, by crate.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "answers",
        "serves"
      ]
    },
    "ModulesOutput": {
      "description": "The catalog, and the game's modules.",
      "type": "object",
      "properties": {
        "concerns": {
          "description": "The concerns, each with its answers, who gives each and its\nstatus.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Concern"
          }
        },
        "engine": {
          "description": "The engine checkout read, `/`-separated.",
          "type": "string"
        },
        "modules": {
          "description": "The modules the engine builds, by name.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModuleEntry"
          }
        },
        "on": {
          "description": "The modules the game has on, by name, in its `Cargo.toml`'s order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "engine",
        "concerns",
        "modules",
        "on"
      ]
    },
    "Status": {
      "description": "Whether an answer or a module is built.",
      "oneOf": [
        {
          "description": "Built, with an example passing CI.",
          "type": "string",
          "const": "ready"
        },
        {
          "description": "Ticketed, not built yet.",
          "type": "string",
          "const": "planned"
        },
        {
          "description": "Not started until the plan says.",
          "type": "string",
          "const": "parked"
        }
      ]
    }
  }
}
