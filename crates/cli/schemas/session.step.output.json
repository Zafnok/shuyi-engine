{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer",
  "description": "What an operation answers.",
  "type": "object",
  "properties": {
    "code": {
      "description": "The problem code of its error (`SH1002`), or of its failure when\nit ran and failed on the setup (`doctor`); `shuyi explain <code>`\nprints its page.",
      "type": [
        "string",
        "null"
      ]
    },
    "contract": {
      "description": "The contract's version ([`VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error": {
      "description": "Why it could not run, if it could not.",
      "type": [
        "string",
        "null"
      ]
    },
    "help": {
      "description": "How to fix it, with the code.",
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "description": "What it could not determine, in plain words.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "description": "Whether it passed: nothing found by a check, runs that agree, a\ngame made, a toolchain complete. False too when it could not run.",
      "type": "boolean"
    },
    "op": {
      "description": "The operation.",
      "type": "string",
      "const": "step"
    },
    "result": {
      "description": "What it found or made; absent when it could not run.",
      "anyOf": [
        {
          "$ref": "#/$defs/RunOutput"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "op",
    "ok",
    "limits"
  ],
  "$defs": {
    "Event": {
      "description": "Something that happened while a session ran, with its frame (frames\ncount from 1).",
      "oneOf": [
        {
          "description": "A screen opened.",
          "type": "object",
          "properties": {
            "frame": {
              "description": "The frame.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "opened"
            },
            "screen": {
              "description": "Its name.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "frame",
            "screen"
          ]
        },
        {
          "description": "A screen closed.",
          "type": "object",
          "properties": {
            "frame": {
              "description": "The frame.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "closed"
            },
            "screen": {
              "description": "Its name.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "frame",
            "screen"
          ]
        },
        {
          "description": "A music command to the platform.",
          "type": "object",
          "properties": {
            "command": {
              "description": "`load`, `start`, `gain` or `stop`.",
              "type": "string"
            },
            "cue": {
              "description": "The track's cue.",
              "type": "string"
            },
            "frame": {
              "description": "The frame.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "music"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "frame",
            "command",
            "cue"
          ]
        },
        {
          "description": "A voiced line asked to play.",
          "type": "object",
          "properties": {
            "frame": {
              "description": "The frame.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "voice"
            },
            "line": {
              "description": "The line's id.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "frame",
            "line"
          ]
        },
        {
          "description": "The game asked to quit.",
          "type": "object",
          "properties": {
            "frame": {
              "description": "The frame.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "quit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "frame"
          ]
        },
        {
          "description": "Something in the game's rules, in the game's words (it gives no\nframe).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "game"
            },
            "text": {
              "description": "What happened.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ]
        }
      ]
    },
    "HeapDiff": {
      "description": "What grew and shrank in the heap between two snapshots\n([`HeapSnapshot::diff`]). Build an empty one with [`HeapDiff::new`]\n(ADR-0039).",
      "type": "object",
      "properties": {
        "from": {
          "description": "The earlier snapshot's frame.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "live_bytes": {
          "description": "How many more bytes are live: less than 0 for fewer.",
          "type": "integer",
          "format": "int64"
        },
        "tags": {
          "description": "The tags whose live bytes or blocks changed: the largest change in\nbytes first (more or fewer), then by class, then by name.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TagDelta"
          }
        },
        "to": {
          "description": "The later snapshot's frame.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "live_bytes",
        "tags"
      ]
    },
    "HeapSummary": {
      "description": "How the heap's counts add up over a trace's records, in bytes asked for.",
      "type": "object",
      "properties": {
        "allocs": {
          "description": "How the allocations per frame spread.",
          "$ref": "#/$defs/Spread"
        },
        "live_bytes": {
          "description": "The bytes live at the last record's end.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "peak_bytes": {
          "description": "The most bytes live at once, the most of the records' peaks.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "peak_bytes",
        "live_bytes",
        "allocs"
      ]
    },
    "LogEntry": {
      "description": "A line of the game's log.",
      "type": "object",
      "properties": {
        "category": {
          "description": "What it is about: `assets`, `audio`, `input`, `screens`, `storage`,\n`platform` or `game`.",
          "type": "string"
        },
        "frame": {
          "description": "The frame it was given in (frames count from 1; 0 is before the\nfirst).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "level": {
          "description": "How serious it is: `error`, `warn`, `info` or `debug`.",
          "type": "string"
        },
        "text": {
          "description": "What it says, in English.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "frame",
        "level",
        "category",
        "text"
      ]
    },
    "ModuleEntry": {
      "description": "A module installed in the game, with what it declared (ADR-0040).",
      "type": "object",
      "properties": {
        "debug_entries": {
          "description": "Its entries' names on the debug menu, as they read at install, in\nthe order declared; the menu lists them after the game's.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hooks": {
          "description": "The hooks the game calls on it, in the frame loop: `before_update`\n(before the screens' update), `draw_over` (over their drawing).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "description": "Its name.",
          "type": "string"
        },
        "states": {
          "description": "The types of the state it put on the context.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "hooks",
        "states",
        "debug_entries"
      ]
    },
    "PerfSummary": {
      "description": "What a trace's records add up to.",
      "type": "object",
      "properties": {
        "draw": {
          "description": "How the drawing's spread (`draw_us`).",
          "$ref": "#/$defs/Spread"
        },
        "dropped": {
          "description": "How many earlier frames' records were no longer kept.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "file": {
          "description": "The trace file written, its absolute path, with `--perf-out`.",
          "type": [
            "string",
            "null"
          ]
        },
        "frame": {
          "description": "How the whole frame's time spread (`frame_us`).",
          "$ref": "#/$defs/Spread"
        },
        "frames": {
          "description": "The records summed up: the frames kept.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "heap": {
          "description": "The heap's counts over the records that have them; null where none\nhas (a release build of the tool program, or one opted out).",
          "anyOf": [
            {
              "$ref": "#/$defs/HeapSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "heap_growth": {
          "description": "What grew and shrank from the snapshot before the run to the one\nafter: the diff, with its first ten rows, the largest change first.\nNull without snapshots.",
          "anyOf": [
            {
              "$ref": "#/$defs/HeapDiff"
            },
            {
              "type": "null"
            }
          ]
        },
        "heap_tags": {
          "description": "What held the heap after the last frame: the snapshot's first ten\nrows by tag, the most live bytes first. Empty without a snapshot.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TagRow"
          }
        },
        "paint": {
          "description": "How painting into the window spread (`paint_us`).",
          "$ref": "#/$defs/Spread"
        },
        "present": {
          "description": "How the backend's swap and wait spread (`present_us`).",
          "$ref": "#/$defs/Spread"
        },
        "spans": {
          "description": "The spans with the most time in all, most first (ties by name), at\nmost five.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpanSummary"
          }
        },
        "update": {
          "description": "How the update's spread (`update_us`).",
          "$ref": "#/$defs/Spread"
        }
      },
      "additionalProperties": false,
      "required": [
        "frames",
        "dropped",
        "frame",
        "update",
        "draw",
        "paint",
        "present",
        "spans",
        "heap_tags"
      ]
    },
    "RunOutput": {
      "description": "What `run` saw.",
      "type": "object",
      "properties": {
        "events": {
          "description": "What happened, in frame order, then the game's own events.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Event"
          }
        },
        "frame": {
          "description": "The last frame drawn, in the snapshot text format.",
          "type": "string"
        },
        "frames": {
          "description": "The frames run in all.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "log": {
          "description": "The game's log, oldest first: its last lines.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LogEntry"
          }
        },
        "modules": {
          "description": "The modules installed in the game, in install order, with the\nhooks the game calls on each.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModuleEntry"
          }
        },
        "perf": {
          "description": "The frames' times, with `perf`: none without it, or when nothing\nwas measured.",
          "anyOf": [
            {
              "$ref": "#/$defs/PerfSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "quit": {
          "description": "The frame the game asked to quit in, if it did.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "scene": {
          "description": "The scene on screen, if a stage is open.",
          "anyOf": [
            {
              "$ref": "#/$defs/Scene"
            },
            {
              "type": "null"
            }
          ]
        },
        "screens": {
          "description": "The open screens, bottom first.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sounds": {
          "description": "The sound cues asked for, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Sound"
          }
        },
        "top_screen": {
          "description": "The top screen's name; empty once every screen has closed.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "frames",
        "top_screen",
        "screens",
        "frame",
        "events",
        "sounds",
        "log",
        "modules"
      ]
    },
    "Scene": {
      "description": "The scene a stage shows, as text and as data.",
      "type": "object",
      "properties": {
        "data": {
          "description": "What the game says of it as data: its stage's state."
        },
        "kind": {
          "description": "What kind of scene: `grid map`, or the game's own word.",
          "type": "string"
        },
        "screen": {
          "description": "The screen it is on.",
          "type": "string"
        },
        "text": {
          "description": "The scene as text: for a grid map, its tiles, units and cursor in\nthe scene's text form (`MapScene::to_text`).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "screen",
        "kind",
        "text",
        "data"
      ]
    },
    "Sound": {
      "description": "A sound cue asked to play.",
      "type": "object",
      "properties": {
        "cue": {
          "description": "The cue.",
          "type": "string"
        },
        "frame": {
          "description": "The frame.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "frame",
        "cue"
      ]
    },
    "SpanSummary": {
      "description": "A span's name and how its time adds up over the records.",
      "type": "object",
      "properties": {
        "count": {
          "description": "How many times it ended.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "mean_us": {
          "description": "Its mean time, in microseconds, rounded down.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "description": "What the game called it (`ctx.span(\"ai\", …)`).",
          "type": "string"
        },
        "total_us": {
          "description": "Its time in all, in microseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "worst_us": {
          "description": "Its longest time, in microseconds.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "count",
        "total_us",
        "mean_us",
        "worst_us"
      ]
    },
    "Spread": {
      "description": "How a set of times spread, in whole microseconds: the median, the 99th\npercentile (nearest rank), the worst and the mean rounded down.",
      "type": "object",
      "properties": {
        "mean": {
          "description": "The mean, rounded down.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "p50": {
          "description": "The median: half the times are this or less.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "p99": {
          "description": "99 in a hundred times are this or less.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "worst": {
          "description": "The longest.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "p50",
        "p99",
        "worst",
        "mean"
      ]
    },
    "TagClass": {
      "description": "What a memory tag names (ADR-0046 §6): the heap counter counts each\nblock under the innermost tag entered when it was allocated. Its number\nis the class a backend's counter keeps with each name\n([`MemoryScopes::tag`]); `Other` is 0, the class of the counter's own\n`other` and `overflow`.",
      "oneOf": [
        {
          "description": "A phase of the frame: `load`, `update`, `draw`, `paint`, `perf`,\nand `app` for the rest of `App`'s frame.",
          "type": "string",
          "const": "phase"
        },
        {
          "description": "A span the game marked ([`Ctx::span`](crate::Ctx::span)).",
          "type": "string",
          "const": "span"
        },
        {
          "description": "An asset kind being decoded: `image`, `palette`, …",
          "type": "string",
          "const": "asset"
        },
        {
          "description": "None of those: `other`, what is allocated outside any tag, and\n`overflow`, the names past the counter's table.",
          "type": "string",
          "const": "other"
        }
      ]
    },
    "TagDelta": {
      "description": "How one memory tag changed between two snapshots. Build it with\n[`TagDelta::new`] (ADR-0039).",
      "type": "object",
      "properties": {
        "class": {
          "description": "What the tag names.",
          "$ref": "#/$defs/TagClass"
        },
        "live_blocks": {
          "description": "How many more blocks are live under it: less than 0 for fewer.",
          "type": "integer",
          "format": "int64"
        },
        "live_bytes": {
          "description": "How many more bytes are live under it: less than 0 for fewer.",
          "type": "integer",
          "format": "int64"
        },
        "name": {
          "description": "Its name.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "class",
        "name",
        "live_bytes",
        "live_blocks"
      ]
    },
    "TagRow": {
      "description": "One memory tag's counts in a [`HeapSnapshot`], in bytes asked for.\nBuild it with [`TagRow::new`] (ADR-0039).",
      "type": "object",
      "properties": {
        "allocated_bytes": {
          "description": "The bytes ever allocated under it: a block grown adds its new size.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "class": {
          "description": "What the tag names: a phase, a span, an asset kind, or `other`.",
          "$ref": "#/$defs/TagClass"
        },
        "live_blocks": {
          "description": "The blocks live under it.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "live_bytes": {
          "description": "The bytes live under it: allocated, or last grown, under it and not\nyet freed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "name": {
          "description": "Its name: `update`, the span's (`ai`), the asset kind's (`image`),\n`other` or `overflow`.",
          "type": "string"
        },
        "peak_bytes": {
          "description": "The most bytes live under it at once.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "class",
        "name",
        "live_bytes",
        "live_blocks",
        "allocated_bytes",
        "peak_bytes"
      ]
    }
  }
}
