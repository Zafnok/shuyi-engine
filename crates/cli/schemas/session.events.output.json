{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer",
  "description": "What an operation answers.",
  "type": "object",
  "properties": {
    "code": {
      "description": "The problem code of its error (`SH1002`), or of its failure when\nit ran and failed on the setup (`doctor`); `shuyi explain <code>`\nprints its page.",
      "type": [
        "string",
        "null"
      ]
    },
    "contract": {
      "description": "The contract's version ([`VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error": {
      "description": "Why it could not run, if it could not.",
      "type": [
        "string",
        "null"
      ]
    },
    "help": {
      "description": "How to fix it, with the code.",
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "description": "What it could not determine, in plain words.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "description": "Whether it passed: nothing found by a check, runs that agree, a\ngame made, a toolchain complete. False too when it could not run.",
      "type": "boolean"
    },
    "op": {
      "description": "The operation.",
      "type": "string",
      "const": "events"
    },
    "result": {
      "description": "What it found or made; absent when it could not run.",
      "anyOf": [
        {
          "$ref": "#/$defs/EventsOutput"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "op",
    "ok",
    "limits"
  ],
  "$defs": {
    "Event": {
      "description": "Something that happened while a session ran, with its frame (frames\ncount from 1).",
      "oneOf": [
        {
          "description": "A screen opened.",
          "type": "object",
          "properties": {
            "frame": {
              "description": "The frame.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "opened"
            },
            "screen": {
              "description": "Its name.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "frame",
            "screen"
          ]
        },
        {
          "description": "A screen closed.",
          "type": "object",
          "properties": {
            "frame": {
              "description": "The frame.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "closed"
            },
            "screen": {
              "description": "Its name.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "frame",
            "screen"
          ]
        },
        {
          "description": "A music command to the platform.",
          "type": "object",
          "properties": {
            "command": {
              "description": "`load`, `start`, `gain` or `stop`.",
              "type": "string"
            },
            "cue": {
              "description": "The track's cue.",
              "type": "string"
            },
            "frame": {
              "description": "The frame.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "music"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "frame",
            "command",
            "cue"
          ]
        },
        {
          "description": "A voiced line asked to play.",
          "type": "object",
          "properties": {
            "frame": {
              "description": "The frame.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "voice"
            },
            "line": {
              "description": "The line's id.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "frame",
            "line"
          ]
        },
        {
          "description": "The game asked to quit.",
          "type": "object",
          "properties": {
            "frame": {
              "description": "The frame.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "quit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "frame"
          ]
        },
        {
          "description": "Something in the game's rules, in the game's words (it gives no\nframe).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "game"
            },
            "text": {
              "description": "What happened.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ]
        }
      ]
    },
    "EventsOutput": {
      "description": "What `events` saw.",
      "type": "object",
      "properties": {
        "events": {
          "description": "What happened since the start, in frame order, then the game's own\nevents.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Event"
          }
        },
        "frames": {
          "description": "The frames run in all.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sounds": {
          "description": "The sound cues asked for since the start, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Sound"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "frames",
        "events",
        "sounds"
      ]
    },
    "Sound": {
      "description": "A sound cue asked to play.",
      "type": "object",
      "properties": {
        "cue": {
          "description": "The cue.",
          "type": "string"
        },
        "frame": {
          "description": "The frame.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "frame",
        "cue"
      ]
    }
  }
}
