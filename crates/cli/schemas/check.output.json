{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer",
  "description": "What an operation answers.",
  "type": "object",
  "properties": {
    "contract": {
      "description": "The contract's version ([`VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error": {
      "description": "Why it could not run, if it could not.",
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "description": "What it could not determine, in plain words.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "description": "Whether it passed: nothing found by a check, runs that agree, a\ngame made, a toolchain complete. False too when it could not run.",
      "type": "boolean"
    },
    "op": {
      "description": "The operation.",
      "$ref": "#/$defs/Op"
    },
    "result": {
      "description": "What it found or made; absent when it could not run.",
      "anyOf": [
        {
          "$ref": "#/$defs/CheckOutput"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "op",
    "ok",
    "limits"
  ],
  "$defs": {
    "CheckOutput": {
      "description": "What `check` found.",
      "type": "object",
      "properties": {
        "errors": {
          "description": "Every error of the game's content, in the order the game's\nvalidators found them (none with a target).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Problem"
          }
        },
        "targets": {
          "description": "Each target checked, with its problems (none without a target).",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TargetReport"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "errors"
      ]
    },
    "Level": {
      "description": "How bad a target problem is.",
      "oneOf": [
        {
          "description": "The game doesn't fit the target: the check fails.",
          "type": "string",
          "const": "error"
        },
        {
          "description": "It fits, short of what the target recommends.",
          "type": "string",
          "const": "warning"
        }
      ]
    },
    "Op": {
      "description": "An operation of the contract.",
      "oneOf": [
        {
          "description": "A new game from a template.",
          "type": "string",
          "const": "new"
        },
        {
          "description": "Every error of the game's content.",
          "type": "string",
          "const": "check"
        },
        {
          "description": "A key script played headless.",
          "type": "string",
          "const": "run"
        },
        {
          "description": "The scene on screen.",
          "type": "string",
          "const": "scene"
        },
        {
          "description": "A record replayed.",
          "type": "string",
          "const": "replay"
        },
        {
          "description": "Bots playing the game.",
          "type": "string",
          "const": "bots"
        },
        {
          "description": "A file read through the format registry.",
          "type": "string",
          "const": "import"
        },
        {
          "description": "The game's sources baked into a pack.",
          "type": "string",
          "const": "bake"
        },
        {
          "description": "The toolchain checked.",
          "type": "string",
          "const": "doctor"
        }
      ]
    },
    "Problem": {
      "description": "A problem in a file: what a validator found, with where.",
      "type": "object",
      "properties": {
        "column": {
          "description": "Its 1-based column, if known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "file": {
          "description": "The file, as the game shows it (`files/stage.map`).",
          "type": "string"
        },
        "line": {
          "description": "Its 1-based line, if known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "message": {
          "description": "What is wrong.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "message"
      ]
    },
    "TargetCheck": {
      "description": "Which check found a target problem.",
      "oneOf": [
        {
          "description": "The frame at its scale fits the display.",
          "type": "string",
          "const": "fits"
        },
        {
          "description": "The smallest text is tall enough.",
          "type": "string",
          "const": "text"
        },
        {
          "description": "The required actions of each screen bind to distinct inputs of the\ntarget.",
          "type": "string",
          "const": "controls"
        },
        {
          "description": "On a one-bit display, every role has patterns and the roles that\ntell things apart stay distinct.",
          "type": "string",
          "const": "one-bit"
        }
      ]
    },
    "TargetProblem": {
      "description": "A problem of the game on one target.",
      "type": "object",
      "properties": {
        "actions": {
          "description": "The actions a controls problem is about, by name.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "check": {
          "description": "The check that found it.",
          "$ref": "#/$defs/TargetCheck"
        },
        "inputs": {
          "description": "The inputs a controls problem is about, as the keymap file names\nthem (`East`, `East+West`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "level": {
          "description": "An error or a warning.",
          "$ref": "#/$defs/Level"
        },
        "message": {
          "description": "What is wrong, with the numbers.",
          "type": "string"
        },
        "roles": {
          "description": "The palette roles a one-bit problem is about (`team.player`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "screen": {
          "description": "The screen a controls problem is about, if one.",
          "type": [
            "string",
            "null"
          ]
        },
        "setting": {
          "description": "The game's setting it is about: in `shuyi.ron`\n(`targets.\"playdate\".frame`), the keymap file's table for the\ntarget (`keymap targets.\"playdate\"`), a screen's declaration\n(`screen \"title\"`), or the skin's pattern map\n(`files/palette@onebit.ron`).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "level",
        "check",
        "setting",
        "message"
      ]
    },
    "TargetReport": {
      "description": "What `check --target` found on one target.",
      "type": "object",
      "properties": {
        "problems": {
          "description": "Every problem, errors and warnings, display by display.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetProblem"
          }
        },
        "profile": {
          "description": "The profile's file: the engine's (`targets/playdate.ron`) or the\ngame's.",
          "type": "string"
        },
        "target": {
          "description": "The target's id.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "target",
        "profile",
        "problems"
      ]
    }
  }
}
