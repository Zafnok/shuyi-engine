{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer",
  "description": "What an operation answers.",
  "type": "object",
  "properties": {
    "code": {
      "description": "The problem code of its error (`SH1002`), or of its failure when\nit ran and failed on the setup (`doctor`); `shuyi explain <code>`\nprints its page.",
      "type": [
        "string",
        "null"
      ]
    },
    "contract": {
      "description": "The contract's version ([`VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "error": {
      "description": "Why it could not run, if it could not.",
      "type": [
        "string",
        "null"
      ]
    },
    "help": {
      "description": "How to fix it, with the code.",
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "description": "What it could not determine, in plain words.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "description": "Whether it passed: nothing found by a check, runs that agree, a\ngame made, a toolchain complete. False too when it could not run.",
      "type": "boolean"
    },
    "op": {
      "description": "The operation.",
      "$ref": "#/$defs/Op"
    },
    "result": {
      "description": "What it found or made; absent when it could not run.",
      "anyOf": [
        {
          "$ref": "#/$defs/AutobalanceOutput"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "op",
    "ok",
    "limits"
  ],
  "$defs": {
    "AutobalanceOutput": {
      "description": "What `autobalance` found.",
      "type": "object",
      "properties": {
        "after": {
          "description": "The stage found, at the full tries (the stage as authored when\nnothing changed).",
          "$ref": "#/$defs/PlaytestReport"
        },
        "before": {
          "description": "The stage as authored, at the full tries.",
          "$ref": "#/$defs/PlaytestReport"
        },
        "changes": {
          "description": "Every knob it moved, in the knobs' order, with the knob's words.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Change"
          }
        },
        "evaluations": {
          "description": "The evaluations it made.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "in_bands": {
          "description": "Whether every rate of the stage found is in its band.",
          "type": "boolean"
        },
        "seconds": {
          "description": "The search's wall time, in seconds: the one number that changes\nwith the machine and the thread count.",
          "type": "number",
          "format": "double"
        },
        "settings": {
          "description": "The search's numbers, the defaults filled in.",
          "$ref": "#/$defs/BalanceSettings"
        },
        "stage": {
          "description": "The stage, if the game names its stages.",
          "type": [
            "string",
            "null"
          ]
        },
        "stop": {
          "description": "Why the search stopped.",
          "$ref": "#/$defs/Stop"
        },
        "title": {
          "description": "The plan's title.",
          "type": "string"
        },
        "written": {
          "description": "With `apply`: the files the game wrote, none when nothing changed.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "settings",
        "in_bands",
        "stop",
        "evaluations",
        "changes",
        "before",
        "after",
        "seconds"
      ]
    },
    "BalanceSettings": {
      "description": "How hard the search works.",
      "type": "object",
      "properties": {
        "evaluations": {
          "description": "The most runs of the playtest runner the search makes, the first\nrun of the stage as authored among them.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "quick": {
          "description": "The try count of the search's own runs, from the same first seed.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "tries": {
          "description": "The full run, which decides \"in band\": the stage as authored and\nthe stage found are both played this way.",
          "$ref": "#/$defs/Tries"
        }
      },
      "additionalProperties": false,
      "required": [
        "tries",
        "quick",
        "evaluations"
      ]
    },
    "Band": {
      "description": "A share of tries in percent, both ends inclusive.",
      "type": "object",
      "properties": {
        "max": {
          "description": "The greatest share, in percent.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "min": {
          "description": "The least share, in percent.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ]
    },
    "Change": {
      "description": "One knob the search moved.",
      "type": "object",
      "properties": {
        "knob": {
          "description": "The knob's name.",
          "type": "string"
        },
        "step": {
          "description": "Its step.",
          "type": "integer",
          "format": "int32"
        },
        "what": {
          "description": "The knob's words for the step.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "knob",
        "step",
        "what"
      ]
    },
    "Check": {
      "description": "A check of a run, kept as data.",
      "oneOf": [
        {
          "description": "The share of `entrant`'s tries that meet every `success` condition\nis within `band`. A share under `floor` percent blocks the run.",
          "type": "object",
          "properties": {
            "Rate": {
              "type": "object",
              "properties": {
                "band": {
                  "description": "The share wanted.",
                  "$ref": "#/$defs/Band"
                },
                "entrant": {
                  "description": "The entrant checked.",
                  "type": "string"
                },
                "floor": {
                  "description": "The share under which the run is blocked, in percent.",
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "uint32",
                  "default": null,
                  "minimum": 0
                },
                "success": {
                  "description": "What a success is.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Condition"
                  }
                }
              },
              "required": [
                "entrant",
                "success",
                "band"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Rate"
          ]
        },
        {
          "description": "The median of `measure` over `entrant`'s tries that meet `among`\nis lower or higher than the same median of entrant `than`.",
          "type": "object",
          "properties": {
            "Median": {
              "type": "object",
              "properties": {
                "among": {
                  "description": "Which tries count.",
                  "type": "array",
                  "default": [],
                  "items": {
                    "$ref": "#/$defs/Condition"
                  }
                },
                "entrant": {
                  "description": "The entrant checked.",
                  "type": "string"
                },
                "measure": {
                  "description": "The measure.",
                  "type": "string"
                },
                "than": {
                  "description": "The entrant compared with.",
                  "type": "string"
                },
                "want": {
                  "description": "Which way it should lean.",
                  "$ref": "#/$defs/Want"
                }
              },
              "required": [
                "entrant",
                "measure",
                "want",
                "than"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Median"
          ]
        }
      ]
    },
    "Condition": {
      "description": "A measure within bounds, both ends inclusive. A try missing the\nmeasure fails it.",
      "type": "object",
      "properties": {
        "max": {
          "description": "Its greatest value, if it has one.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        },
        "measure": {
          "description": "The measure's name.",
          "type": "string"
        },
        "min": {
          "description": "Its least value, if it has one.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "measure"
      ]
    },
    "EntrantTries": {
      "description": "One entrant's tries, in seed order.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Its name.",
          "type": "string"
        },
        "tries": {
          "description": "Its tries.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tried"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "tries"
      ]
    },
    "Found": {
      "description": "What a check found.",
      "oneOf": [
        {
          "description": "A [`Check::Rate`]'s numbers.",
          "type": "object",
          "properties": {
            "Rate": {
              "type": "object",
              "properties": {
                "blocked": {
                  "description": "Whether it is under the floor.",
                  "type": "boolean"
                },
                "count": {
                  "description": "The tries.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "successes": {
                  "description": "The tries that succeeded.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "verdict": {
                  "description": "Where the share falls.",
                  "$ref": "#/$defs/RateVerdict"
                }
              },
              "required": [
                "successes",
                "count",
                "verdict",
                "blocked"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Rate"
          ]
        },
        {
          "description": "A [`Check::Median`]'s numbers.",
          "type": "object",
          "properties": {
            "Median": {
              "type": "object",
              "properties": {
                "median": {
                  "description": "The entrant's median, if it has a try to take it of.",
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "int64"
                },
                "than": {
                  "description": "The other entrant's.",
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "int64"
                },
                "verdict": {
                  "description": "How they compare.",
                  "$ref": "#/$defs/MedianVerdict"
                }
              },
              "required": [
                "verdict"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Median"
          ]
        }
      ]
    },
    "Judged": {
      "description": "A check and what it found.",
      "type": "object",
      "properties": {
        "check": {
          "description": "The check.",
          "$ref": "#/$defs/Check"
        },
        "found": {
          "description": "What it found.",
          "$ref": "#/$defs/Found"
        }
      },
      "additionalProperties": false,
      "required": [
        "check",
        "found"
      ]
    },
    "MedianVerdict": {
      "description": "How a median compares.",
      "oneOf": [
        {
          "description": "It leans the way wanted (✓).",
          "type": "string",
          "const": "Pass"
        },
        {
          "description": "It doesn't (✗).",
          "type": "string",
          "const": "Fail"
        },
        {
          "description": "One side has no try to take a median of (–).",
          "type": "string",
          "const": "Unknown"
        }
      ]
    },
    "Op": {
      "description": "An operation of the contract.",
      "oneOf": [
        {
          "description": "A new game from a template.",
          "type": "string",
          "const": "new"
        },
        {
          "description": "Every error of the game's content.",
          "type": "string",
          "const": "check"
        },
        {
          "description": "What is wrong with the shape of the game's code.",
          "type": "string",
          "const": "lint"
        },
        {
          "description": "The catalog of modules, and the game's.",
          "type": "string",
          "const": "modules"
        },
        {
          "description": "A module turned on.",
          "type": "string",
          "const": "add"
        },
        {
          "description": "A key script played headless.",
          "type": "string",
          "const": "run"
        },
        {
          "description": "The scene on screen.",
          "type": "string",
          "const": "scene"
        },
        {
          "description": "A record replayed.",
          "type": "string",
          "const": "replay"
        },
        {
          "description": "Bots playing the game.",
          "type": "string",
          "const": "bots"
        },
        {
          "description": "Named bots' tries judged against the game's checks.",
          "type": "string",
          "const": "playtest"
        },
        {
          "description": "A stage changed until the game's named bots land in their bands.",
          "type": "string",
          "const": "autobalance"
        },
        {
          "description": "A file read through the format registry.",
          "type": "string",
          "const": "import"
        },
        {
          "description": "The game's sources baked into a pack.",
          "type": "string",
          "const": "bake"
        },
        {
          "description": "The toolchain checked.",
          "type": "string",
          "const": "doctor"
        },
        {
          "description": "A problem code's page.",
          "type": "string",
          "const": "explain"
        },
        {
          "description": "The MCP session's game started headless.",
          "type": "string",
          "const": "start"
        },
        {
          "description": "The MCP session's game played on: a script, then idle frames.",
          "type": "string",
          "const": "step"
        },
        {
          "description": "A picture of the MCP session's frame.",
          "type": "string",
          "const": "frame_png"
        },
        {
          "description": "What happened in the MCP session's game.",
          "type": "string",
          "const": "events"
        },
        {
          "description": "The MCP session's game started again.",
          "type": "string",
          "const": "reset"
        },
        {
          "description": "The MCP session's game stopped.",
          "type": "string",
          "const": "stop"
        }
      ]
    },
    "PlaytestReport": {
      "description": "What a playtest found. Its `Display` is the table people read; a game\nadds its own lines from the data.",
      "type": "object",
      "properties": {
        "blocked": {
          "description": "Whether a rate fell under its floor.",
          "type": "boolean"
        },
        "checks": {
          "description": "Every check, in the order given, and what it found.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Judged"
          }
        },
        "entrants": {
          "description": "Every entrant's tries, in the order given.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EntrantTries"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "entrants",
        "checks",
        "blocked"
      ]
    },
    "RateVerdict": {
      "description": "Where a share of tries falls against a [`Band`].",
      "oneOf": [
        {
          "description": "Under the band: too hard (✗).",
          "type": "string",
          "const": "Below"
        },
        {
          "description": "In the band (✓).",
          "type": "string",
          "const": "Within"
        },
        {
          "description": "Over the band: too easy (⚠).",
          "type": "string",
          "const": "Above"
        }
      ]
    },
    "Stop": {
      "description": "Why the search stopped.",
      "oneOf": [
        {
          "description": "The stage as authored was in every band: nothing changed.",
          "type": "string",
          "const": "AlreadyInBands"
        },
        {
          "description": "The change set puts every rate in its band. If the budget ran out,\nor the caller said to stop, while it was being pruned, it may be\nlarger than it had to be.",
          "type": "string",
          "const": "InBands"
        },
        {
          "description": "No knob's step brought the stage any nearer its bands: the change\nset is the nearest the search came.",
          "type": "string",
          "const": "Stuck"
        },
        {
          "description": "The budget of evaluations ran out first: the change set is the\nbest setting seen.",
          "type": "string",
          "const": "Budget"
        },
        {
          "description": "The caller said to stop ([`autobalance_by`]'s `should_stop`, such\nas the tools' time limit): the change set is the best setting seen.",
          "type": "string",
          "const": "Stopped"
        }
      ]
    },
    "Tried": {
      "description": "One try of one entrant.",
      "type": "object",
      "properties": {
        "measures": {
          "description": "The game's measures of it.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "int64"
          }
        },
        "outcome": {
          "description": "How the game ended, as the outcome's `Debug` writes it; `None` if\nthe turn limit stopped it.",
          "type": [
            "string",
            "null"
          ]
        },
        "seed": {
          "description": "Its seed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "turns": {
          "description": "The turn it stopped on (past the limit if the limit stopped it).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "seed",
        "turns",
        "measures"
      ]
    },
    "Tries": {
      "description": "K tries from seeds `seed` to `seed + count - 1` (those that fit in a\n`u64`), each stopped at turn `turns` if it hasn't ended. Every entrant\nplays the same seeds.",
      "type": "object",
      "properties": {
        "count": {
          "description": "How many tries.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "seed": {
          "description": "The first try's seed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "turns": {
          "description": "The turn a try stops at if it hasn't ended.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "count",
        "seed",
        "turns"
      ]
    },
    "Want": {
      "description": "Which way a median should lean.",
      "oneOf": [
        {
          "description": "Strictly lower than the other entrant's.",
          "type": "string",
          "const": "Lower"
        },
        {
          "description": "Strictly higher than the other entrant's.",
          "type": "string",
          "const": "Higher"
        }
      ]
    }
  }
}
