// Moon Garden's English: every screen's text by key. A `{name}` that is
// an action's name shows the player's key for it, and `{Cursor}` the four
// direction keys.
{
    // The keys and layouts the engine names.
    "keys.not_mapped": "! not mapped",
    "keys.arrows": "arrows",
    "keys.chord_join": "+",
    "layout.arrows": "Arrows",

    // ANCHOR: title
    // The title.
    "title.name": "Moon Garden",
    "title.subtitle": "made with Shuyi Engine",
    "title.help": "{Confirm} plant · {Cancel} leave",
    // ANCHOR_END: title

    // ANCHOR: garden
    // The garden.
    "garden.seeds": "{seeds} seeds left",
    "garden.help": "{Cursor} move · {Confirm} plant · {Cancel} leave",
    "garden.won": "Every plot grows. {Confirm} back",
    "garden.lost": "Out of seeds. {Confirm} back",
    // ANCHOR_END: garden
    // ANCHOR: hint
    // A key's name filled in by the code that builds the line.
    "hint.plant": "{key} plants",
    // ANCHOR_END: hint

    // Asked over the garden.
    "leave.question": "Leave the garden?",
    "leave.help": "{Confirm} yes · {Cancel} no",

    // ANCHOR: preview
    // The dialogue preview's, for a writer (chapter 6).
    "preview.tab.scenes": "Scenes",
    "preview.tab.switches": "Switches",
    "preview.tab.lines": "Lines",
    "preview.tab.problems": "Problems",
    "preview.switch.here": "Here",
    "preview.switch.gone": "Gone",
    "preview.switch.on": "On",
    "preview.switch.off": "Off",
    "preview.switch.strip": "Strip: file, line, direction",
    "preview.lines.go_to": "Go to line",
    "preview.note.no_scenes": "No scenes: save a .dlg file in the folder",
    "preview.note.no_scenes_drop": "No scenes: drop a .dlg file here",
    "preview.note.no_scene": "Pick a scene first",
    "preview.note.no_problems": "No problems",
    "preview.note.finished": "The scene is over: pick a line to play it again",
    "preview.help": "{Cursor} move · {Confirm} pick · {Cancel} back",
    "preview.help.go_to": "Type a line number · {Confirm} go · {Cancel} close",
    "preview.help.playing": "{Cancel} preview",
    // ANCHOR_END: preview
}
