// Moon Garden's project file, `shuyi.ron` at the root of its folder: what
// `cargo shuyi <command>` builds and runs. Paths are from this folder.
(
    command: "cargo shuyi",

    // ANCHOR: app
    // Who the game is, the same on every target: `cargo shuyi check
    // --target all` checks it, and `cargo shuyi app-info` writes it into
    // `code`, the Rust the game's binary reads.
    app: (
        name: "Moon Garden",
        // Reverse-DNS, unique to the game: its saves are kept under it.
        id: "com.example.moon-garden",
        // Without it, the crate's version.
        version: "0.1.0",
        code: "crates/game/src/app_info.rs",
        // One square PNG, 512 pixels a side or more.
        icon: "art/icon.png",
        // Where `app-info` writes the window's icons, which `code` reads.
        window_icons: "crates/game/icon",
    ),
    // ANCHOR_END: app

    // The game's tool program, for the commands that run the game.
    game: (package: "moon-garden", example: "tools", features: ["tools"]),

    // ANCHOR: targets
    // `cargo shuyi check --target all`: the targets the game ships on,
    // each with its frame in pixels, its scale (`integer` or `fit`) and
    // its smallest text's height.
    targets: {
        "desktop": (frame: (384, 384), scale: integer, text_px: 16),
        "web": (frame: (384, 384), scale: integer, text_px: 16),
    },
    // ANCHOR_END: targets

    // ANCHOR: web
    // `cargo shuyi web`: the game's binary built for the browser, and the
    // page it runs in, written to `dist/web/`.
    web: (
        package: "moon-garden",
        bin: "moon-garden",
        title: "Moon Garden",
        dist: "dist/web",
    ),
    // ANCHOR_END: web

    // The game's own license texts, each written whole into the
    // `NOTICES.txt` of every package the tools make.
    notices: (texts: ["crates/game/files/font/Terminus-LICENSE.txt"]),
)
