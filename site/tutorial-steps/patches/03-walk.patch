+}
+
+/// Why a command was refused.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Refusal {
+    /// A wall is that way.
+    Wall,
+    /// A box is that way, and nothing can push it yet.
+    Box,
+}
