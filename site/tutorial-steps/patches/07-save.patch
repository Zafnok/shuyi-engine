+    let mut h = game::game().harness();
+    let storage = &mut h.ctx_mut().storage;
+    storage
+        .write(game::progress::KEY, "(version: 9, furthest: 3)")
+        .unwrap();
+    assert_eq!(game::progress::furthest(storage), 0);
+    storage.write(game::progress::KEY, "(version").unwrap();
+    assert_eq!(game::progress::furthest(storage), 0);
+}
