// Tic-tac-toe's English: every screen's text by key. A `{name}` that is an
// action's name shows the player's key for it ({Confirm}).
{
    // The keys and layouts the engine names.
    "keys.not_mapped": "! not mapped",
    "keys.arrows": "arrows",
    "keys.chord_join": "+",
    "layout.arrows": "Arrows",

    // The title.
    "title.name": "Tic-tac-toe",
    "title.subtitle": "made with Shuyi Engine",
    // Shown when the game has a stage to start.
    "title.play": "{Confirm} play",
    "title.help": "{Cancel} leave",

    // The stage.
    "stage.to_move": "{mark} to move",
    "stage.won": "{mark} wins!",
    "stage.draw": "A draw.",
    "stage.help": "{Cursor} move · {Confirm} mark · {Cancel} back",
    "stage.help.over": "{Confirm} play again · {Cancel} back",
}
