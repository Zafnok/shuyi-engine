            file: ".github/workflows/mutants.yml",
            find: r##"      #
      # `shuyi-sound`'s adapters (`wav.rs`, `vorbis.rs`) are built only with
      # its `wav` and `vorbis` features, which a run with each package's
      # default features never turns on: they are counted apart, and tested
      # with them on in the `adapters` job (ticket 2043).
"##,
            with: "",
        ),
        Replace(
            file: ".github/workflows/mutants.yml",
            find: r##"          adapters=0
          if [ -s git.diff ]; then
            cargo mutants --in-diff git.diff --list \
              -e crates/sound/src/wav.rs -e crates/sound/src/vorbis.rs > mutants.txt
            mutants=$(wc -l < mutants.txt)
            cargo mutants --in-diff git.diff --list \
              -f crates/sound/src/wav.rs -f crates/sound/src/vorbis.rs > adapters.txt
            adapters=$(wc -l < adapters.txt)
"##,
            with: r##"          if [ -s git.diff ]; then
            cargo mutants --in-diff git.diff --list > mutants.txt
            mutants=$(wc -l < mutants.txt)
"##,
        ),
        Replace(
            file: ".github/workflows/mutants.yml",
            find: r##"          echo "$adapters mutants in the sound adapters"
"##,
            with: "",
        ),
        Replace(
            file: ".github/workflows/mutants.yml",
            find: r##"            echo "adapters=$adapters"
"##,
            with: "",
        ),
        Replace(
            file: ".github/workflows/mutants.yml",
            find: r##"          -e crates/sound/src/wav.rs -e crates/sound/src/vorbis.rs
          --shard "$SHARD/$OF" --sharding round-robin
"##,
            with: r##"          --shard "$SHARD/$OF" --sharding round-robin
"##,
        ),
        Cut(
            file: ".github/workflows/mutants.yml",
            from: "  # `shuyi-sound`'s adapters with the features they are built with",
            to: "  # Single required check for the PR run",
        ),
        Replace(
            file: ".github/workflows/mutants.yml",
            find: "    needs: [changes, plan, baseline, pr, adapters]\n",
            with: "    needs: [changes, plan, baseline, pr]\n",
        ),
        Replace(
            file: ".github/workflows/mutants.yml",
            find: r##"        run: >
          cargo mutants --shard ${{ matrix.shard }}/4 --baseline=skip
          -e crates/sound/src/wav.rs -e crates/sound/src/vorbis.rs
"##,
            with: r##"        run: cargo mutants --shard ${{ matrix.shard }}/4 --baseline=skip
"##,
        ),
        Replace(
            file: ".github/workflows/mutants.yml",
            find: r##"

  # The sound adapters with their features, as the PR run's `adapters` job, and
  # with its nextest profile: three mutants of a source's `read` make a read
  # never end, which a test that checks one read catches at once, but under
  # `cargo test` the run waits on the tests that keep reading and calls the
  # mutant a timeout.
  weekly-adapters:
    if: github.event_name == 'schedule' || github.event_name == 'workflow_dispatch'
    name: mutants (full, sound adapters)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@
        with:
          persist-credentials: false
      - run: rustup show
      - uses: Swatinem/rust-cache@
      - name: Set up Linux
        run: bash scripts/setup-linux.sh
      - uses: taiki-e/install-action@
        with:
          tool: cargo-mutants,cargo-nextest
      - name: Run cargo mutants on the sound adapters
        continue-on-error: true
        env:
          NEXTEST_PROFILE: mutants
        run: >
          cargo mutants --features wav,vorbis
          -f crates/sound/src/wav.rs -f crates/sound/src/vorbis.rs
          --test-tool=nextest -vV
      - name: Upload mutants.out
        if: always()
        uses: actions/upload-artifact@
        with:
          name: mutants-weekly-adapters-${{ github.run_id }}
          path: mutants.out
          if-no-files-found: ignore
"##,
            with: "\n",
        ),
        Replace(
            file: "crates/xtask/src/main.rs",
            find: "        Some(\"sound-parity\") => report(\"sound-parity\", &sound_parity::run(&root, &args[1..]), &[]),\n",
            with: "",
        ),
        // Ticket 2057: the dependency-upkeep skill's step for the footprint.
        Replace(
            file: ".claude/skills/dependency-upkeep/SKILL.md",
            find: r##"Three are known:
   - **The sound give-up footprint** (`sound-give-up`, and the xtask
     test `giving_up_covers_all_the_chain_added`):
     `tools/sound-parity/footprint.ron` names actions and dependencies
     by key (a `uses: owner/action@` line stops at the `@`, a
     `version = ""` matches any version), so a bump of a pin or a
     version leaves it right. If it fails, the bump moved other text an
     edit quotes: run `cargo xtask sound-parity give-up`, and change the
     quoted text it names to the new text, on the PR's branch.
"##,
            with: "Two are known:\n",
        ),
    ],
)
