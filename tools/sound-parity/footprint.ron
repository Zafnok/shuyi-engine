// Everything the sound replacement has added to the repository, so that
// `cargo xtask sound-parity give-up --apply` can take it all out in one go at
// any stage until quad-snd is removed (ADR-0068). A ticket of the chain adds
// its own lines here in the same PR: a test fails on any file that names the
// chain's words and isn't covered, and CI's `sound-give-up` job really gives up
// and builds what is left. Docs and tickets are the give-up skill's to settle.
(
    // Removed whole.
    owned: [
        ".agents/skills/give-up-sound-replacement",
        ".claude/skills/give-up-sound-replacement",
        "crates/app/examples/sound_probe.rs",
        "crates/app/src/audio/in_house",
        "crates/app/src/audio/in_house.rs",
        "crates/cli/web/sound.js",
        "crates/sound",
        "crates/sound-out",
        "crates/xtask/src/sound_parity",
        "crates/xtask/src/sound_parity.rs",
        "tools/sound-parity",
    ],
    // A `find` must be there exactly once, and a `Cut` removes from `from` up to,
    // not including, `to`: one that no longer matches fails the check and CI.
    edits: [
        // Ticket 2210: the sound core and what names it.
        Replace(
            file: ".cargo/mutants.toml",
            find: r##"    # A Vorbis source's `read` asks `next_packet` until the file ends: the mutant
    # that decodes nothing never ends, so it costs a shard its whole timeout and
    # fails it as one, though every test that reads a file would hang on it.
    'VorbisSource<.a>::next_packet -> Result<\(\), Error> with Ok\(\(\)\)',
"##,
            with: "",
        ),
        Replace(
            file: "site/data/api.toml",
            find: "
[[crate]]
name = \"shuyi_sound\"
text = \"decoded sound, its WAV and Ogg Vorbis adapters and an integer mixer, which only the backend of `shuyi-app`'s `in-house-sound` feature plays through yet\"

[[crate]]
name = \"shuyi_sound_out\"
text = \"hands a mix to the system: CPAL on Windows, a Web Audio worklet in the browser, and an output that discards it\"
",
            with: "",
        ),
        Cut(
            file: "Cargo.lock",
            from: "[[package]]\nname = \"shuyi-sound\"",
            to: "[[package]]\nname = \"shuyi-ui\"",
        ),
        Replace(
            file: "Cargo.lock",
            find: " \"shuyi-platform\",\n \"shuyi-sound\",\n \"shuyi-sound-out\",\n",
            with: " \"shuyi-platform\",\n",
        ),
        Replace(
            file: "Cargo.lock",
            find: " \"sha2\",\n \"shuyi-sound\",\n",
            with: " \"sha2\",\n",
        ),
        // Ticket 3030: the mixer's tests in the jobs and the gates that run others.
        Replace(
            file: ".github/workflows/ci.yml",
            find: "run: cargo test -p shuyi-core -p shuyi-ui -p shuyi-platform -p shuyi-sound --no-default-features --locked --no-fail-fast",
            with: "run: cargo test -p shuyi-core -p shuyi-ui -p shuyi-platform --no-default-features --locked --no-fail-fast",
        ),
        Replace(
            file: ".github/workflows/ci.yml",
            find: "run: cargo test --target wasm32-wasip1 --locked --no-fail-fast --lib --tests -p shuyi-core -p shuyi-assets -p shuyi-ui -p shuyi-platform -p shuyi-sound -- --nocapture",
            with: "run: cargo test --target wasm32-wasip1 --locked --no-fail-fast --lib --tests -p shuyi-core -p shuyi-assets -p shuyi-ui -p shuyi-platform -- --nocapture",
        ),
        Replace(
            file: ".claude/skills/run-gates/SKILL.md",
            find: "RUSTFLAGS=\"-D warnings -A unused-imports\" cargo test -p shuyi-core -p shuyi-ui -p shuyi-platform -p shuyi-sound --no-default-features --locked --no-fail-fast",
            with: "RUSTFLAGS=\"-D warnings -A unused-imports\" cargo test -p shuyi-core -p shuyi-ui -p shuyi-platform --no-default-features --locked --no-fail-fast",
        ),
        Replace(
            file: ".claude/skills/run-gates/SKILL.md",
            find: "- on wasm32 under wasmtime in the `determinism` job, with every unit and\n  integration test of `shuyi-core`, `shuyi-assets`, `shuyi-ui`,\n  `shuyi-platform` and `shuyi-sound`, and Hello, Grid's `golden` test.\n",
            with: "- on wasm32 under wasmtime in the `determinism` job, with every unit and\n  integration test of `shuyi-core`, `shuyi-assets`, `shuyi-ui` and\n  `shuyi-platform`, and Hello, Grid's `golden` test.\n",
        ),
        Replace(
            file: ".claude/skills/run-gates/SKILL.md",
            find: "a record's state hash at each step (`examples/hello-grid/tests/golden/hello-grid.ron`),\na script's rendered samples (`crates/sound/tests/golden/mix.ron`).\n",
            with: "a record's state hash at each step (`examples/hello-grid/tests/golden/hello-grid.ron`).\n",
        ),
        Replace(
            file: ".claude/skills/run-gates/SKILL.md",
            find: "cargo test --target wasm32-wasip1 --locked --no-fail-fast --lib --tests -p shuyi-core -p shuyi-assets -p shuyi-ui -p shuyi-platform -p shuyi-sound -- --nocapture",
            with: "cargo test --target wasm32-wasip1 --locked --no-fail-fast --lib --tests -p shuyi-core -p shuyi-assets -p shuyi-ui -p shuyi-platform -- --nocapture",
        ),
        Replace(
            file: "crates/app/Cargo.toml",
            find: "# The sound probe's decoder timings (ticket 2210): only the example uses it.\nshuyi-sound = { path = \"../sound\", features = [\"wav\", \"vorbis\"] }\n",
            with: "",
        ),
        Replace(
            file: "crates/xtask/Cargo.toml",
            find: "# `sound-parity`'s decoder stage: the adapters held to the corpus (ticket 2210).\nshuyi-sound = { path = \"../sound\", features = [\"wav\", \"vorbis\"] }\n",
            with: "",
        ),
        Replace(
            file: "crates/xtask/src/no_std.rs",
            find: r##"&[
    "crates/core",
    "crates/ui",
    "crates/platform",
    "crates/sound",
];"##,
            with: r##"&["crates/core", "crates/ui", "crates/platform"];"##,
        ),
        Replace(
            file: "crates/xtask/src/api/tests.rs",
            find: "assert_eq!(API_CRATES.len(), 11);",
            with: "assert_eq!(API_CRATES.len(), 9);",
        ),
        Replace(
            file: "crates/xtask/src/api.rs",
            find: "//! - `shuyi-app` with the features it had before `in-house-sound`, as that one\n//!   brings CPAL, which needs the root's patch (ADR-0075), and the semver check builds\n//!   a crate outside this workspace.\n//! - The other eight with each tool's own default",
            with: "//! - The other seven with each tool's own default",
        ),
        Replace(
            file: "crates/xtask/src/api.rs",
            find: "    defaults(\"shuyi-sound\"),\n    defaults(\"shuyi-sound-out\"),\n",
            with: "",
        ),
        Replace(
            file: "crates/xtask/src/api.rs",
            find: "    // Its `in-house-sound` can't be built outside this workspace (ADR-0075): the rest,\n    // which is what the semver check's own choice comes to without it.\n    ApiCrate {\n        name: \"shuyi-app\",\n        features: Features::Only(&[\"link\", \"capture\", \"sound-probe\"]),\n    },\n",
            with: "    defaults(\"shuyi-app\"),\n",
        ),
        Replace(
            file: "crates/xtask/src/modules.rs",
            find: r##"/// modules: the front door, this tool, and what only the sound replacement
/// uses until a backend does (ADR-0066, ADR-0068).
const NOT_MODULES: [&str; 4] = ["shuyi", "xtask", "shuyi-sound", "shuyi-sound-out"];"##,
            with: r##"/// modules: the front door and this tool.
const NOT_MODULES: [&str; 2] = ["shuyi", "xtask"];"##,
        ),
        Cut(
            file: "tools/layers.ron",
            from: "        \"shuyi-sound\": (",
            to: "        \"shuyi-cli\": (",
        ),
        Cut(
            file: "README.md",
            from: "| `shuyi-sound` | `crates/sound` |",
            to: "| `shuyi-cli` | `crates/cli` |",
        ),
        Cut(
            file: ".github/workflows/ci.yml",
            from: "  # The first gate on leaving quad-snd",
            to: "  # `shuyi new` (tickets 1129 and 2501)",
        ),
        Replace(
            file: ".github/workflows/ci.yml",
            find: "web-render, sound-parity-windows, sound-parity, sound-give-up, templates,",
            with: "web-render, templates,",
        ),
        Cut(
            file: ".github/workflows/changes.yml",
            from: "# `sound` is narrower (ticket 2573",
            to: "# `crates` is narrower (ticket 2010",
        ),
        Replace(
            file: ".github/workflows/changes.yml",
            find: r##"      sound:
        description: "'true' unless the event is a pull request or a push that changes nothing the sound parity gates cover"
        value: ${{ jobs.detect.outputs.sound }}
"##,
            with: "",
        ),
        Replace(
            file: ".github/workflows/changes.yml",
            find: "      sound: ${{ steps.classify.outputs.sound }}\n",
            with: "",
        ),
        Replace(
            file: ".github/workflows/changes.yml",
            find: "            echo \"sound=true\" >> \"$GITHUB_OUTPUT\"\n",
            with: "",
        ),
        Replace(
            file: ".github/workflows/changes.yml",
            find: "          sound=false\n",
            with: "",
        ),
        Cut(
            file: ".github/workflows/changes.yml",
            from: "            case \"$path\" in\n              crates/app/src/audio*",
            to: "            case \"$path\" in\n              crates/*|templates/*",
        ),
        Replace(
            file: ".github/workflows/changes.yml",
            find: "code=$code crates=$crates sound=$sound\"",
            with: "code=$code crates=$crates\"",
        ),
        Replace(
            file: ".github/workflows/changes.yml",
            find: "          echo \"sound=$sound\" >> \"$GITHUB_OUTPUT\"\n",
            with: "",
        ),
        Cut(
            file: ".claude/skills/run-gates/SKILL.md",
            from: "## The sound parity gates",
            to: "## Golden tables",
        ),
        Cut(
            file: "docs/README.md",
            from: "| The sound parity gates:",
            to: "| Where each fact is written | this file |",
        ),
        Replace(
            file: "crates/app/Cargo.toml",
            find: r##"# `sound-probe`: names the sound backend for the example `sound_probe`, the
# parity gates' probe (ticket 2573, ADR-0066). Off by default; never in a
# shipped build.
sound-probe = []
"##,
            with: "",
        ),
        Replace(
            file: "crates/app/Cargo.toml",
            find: "# The sound probe's plan.\nserde.workspace = true\nron.workspace = true\n",
            with: "",
        ),
        Cut(
            file: "crates/app/Cargo.toml",
            from: "[[example]]\n# The parity gates' probe",
            to: "[[example]]\n# The render card",
        ),
        Replace(
            file: "crates/app/src/lib.rs",
            find: r##"//! With the `sound-probe` feature, `SoundProbeBackend` names the sound
//! backend, for the example `sound_probe` that the parity gates record. No
//! game turns it on.
//!
//! With the `in-house-sound` feature, sound goes through `shuyi-sound`'s mixer and
//! `shuyi-sound-out` instead of quad-snd.
//!
"##,
            with: "",
        ),
        Replace(
            file: "crates/app/src/lib.rs",
            find: "#[cfg(feature = \"sound-probe\")]\npub use crate::audio::Chosen as SoundProbeBackend;\n",
            with: "",
        ),
        // Ticket 3031: the new backend, its output, and what names them.
        Replace(
            file: ".cargo/mutants.toml",
            find: r##"#
# `shuyi-sound-out`'s `windows.rs` and `web.rs` are built only for those targets and
# need a device; what is tested of them is `convert_impl.rs`, the null output, and CI's
# sound parity gates.
#
# `shuyi-sound`'s `wav.rs` and `vorbis.rs` are built only with its features, which a
# run on one package doesn't turn on, so every mutant there would be missed whatever
# the tests say. Their tests run with `--all-features` in `sound-parity`.
"##,
            with: "",
        ),
        Replace(
            file: ".cargo/mutants.toml",
            find: r##"    "crates/sound/src/wav.rs",
    "crates/sound/src/vorbis.rs",
    "crates/sound-out/src/windows.rs",
    "crates/sound-out/src/web.rs",
"##,
            with: "",
        ),
        Replace(
            file: ".cargo/mutants.toml",
            find: r##"    # The default `hold_output` does nothing: its only viable mutant is itself.
    'replace Backend::hold_output with \(\)',
    # Off Windows `preferred_rate` is `None`, which is its only viable mutant there.
    "replace Output::preferred_rate -> Option<u32> with None",
    # Off Windows `Output::stats` is `(0, 0)`, its only viable mutant there.
    'replace Output::stats -> \(u32, u32\) with \(0, 0\)',
    # The web's functions in `sys.rs`, built only for `wasm32`.
    "sound-out/src/sys.rs.*(web|vet|shuyi_sound)",
"##,
            with: "",
        ),
        Cut(
            file: "Cargo.toml",
            from: "# Cargo allows one crate of a build to say",
            to: "[workspace.lints.rust]",
        ),
        Replace(
            file: "crates/app/Cargo.toml",
            find: r##"# `in-house-sound`: the sound replacement's backend, over `shuyi-sound`'s mixer and
# `shuyi-sound-out`, in quad-snd's place (ticket 3031, ADR-0068): the one switch. Off
# by default. A game that turns it on needs the root Cargo.toml's patch of `alsa-sys`
# (ADR-0075).
in-house-sound = ["dep:shuyi-sound", "dep:shuyi-sound-out"]
"##,
            with: "",
        ),
        Replace(
            file: "crates/app/Cargo.toml",
            find: r##"# The `in-house-sound` feature's mixer, adapters and output.
shuyi-sound = { path = "../sound", features = ["wav", "vorbis"], optional = true }
shuyi-sound-out = { path = "../sound-out", optional = true }
"##,
            with: "",
        ),
        Replace(
            file: "crates/app/src/audio.rs",
            find: r##"#[cfg(feature = "in-house-sound")]
pub(crate) mod in_house;
#[cfg(not(target_arch = "wasm32"))]
#[cfg_attr(feature = "in-house-sound", allow(dead_code))]
mod native_music;
"##,
            with: r##"#[cfg(not(target_arch = "wasm32"))]
mod native_music;
"##,
        ),
        Replace(
            file: "crates/app/src/audio.rs",
            find: r##"/// The backend this build plays through: the one place that chooses, by the feature
/// `in-house-sound` (ADR-0068). No game code or file names one.
#[cfg(not(feature = "in-house-sound"))]
pub use device::Macroquad as Chosen;
#[cfg(feature = "in-house-sound")]
pub use in_house::InHouse as Chosen;
"##,
            with: r##"/// The backend this build plays through.
pub(crate) use device::Macroquad as Chosen;
"##,
        ),
        Replace(
            file: "crates/app/src/audio.rs",
            find: r##"#[cfg(not(feature = "in-house-sound"))]
pub(crate) mod device {
"##,
            with: "pub(crate) mod device {\n",
        ),
        Replace(
            file: "crates/platform/src/audio/player.rs",
            find: r##"    /// The system suspends the game (`on`) or has resumed it: a backend whose output
    /// can stop stops it here, after the player has held what sounds.
    fn hold_output(&mut self, on: bool) {
        let _ = on;
    }

"##,
            with: "",
        ),
        Replace(
            file: "docs/platform-backends.md",
            find: "`load_sound_file`, for a device that\n  loads a sound from its own path, `hold_output`, for a device whose whole output\n  can stop while the system suspends the game, and `warn`, which says the player's\n  problems in the backend's log.\n",
            with: "`load_sound_file`, for a device that\n  loads a sound from its own path, and `warn`, which says the player's problems\n  in the backend's log.\n",
