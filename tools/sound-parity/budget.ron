// What the sound parity gates hold (ticket 2573, ADR-0067): every number here
// comes from recordings of quad-snd on CI's pinned image, three independent runs
// of the job (attempts 1 to 3 of CI run 41271510575, 2026-11-01), then held by the
// fresh runs named in the ticket's notes. Four performance limits were set again
// from 58 runs and one of `old_new` from 20 (ticket 2042, written at each), and
// Windows' and the decoders' from 69 and 20 (ticket 2044), and four more natively and
// in the browser from 59 (ticket 2046). Change one only with new runs that justify
// it, written here, and raise `version`: never to pass.
(
    version: 8,
    correctness: (
        // quad-snd's native mix goes in blocks of 4,096 frames, 93 ms, so a command
        // can land a block from where the marker's block puts it: the same copy
        // started about 95 ms apart in two runs. The most measured against a
        // schedule was 40 ms, which is what one run's phase gave, not the bound.
        // This is the block and a little scheduling. A replacement with finer
        // mixing can tighten it.
        timing_ms: 100,
        // Worst measured 0.63 dB: quad-snd natively at a quarter volume.
        level_db: 1.0,
        // Measured 0: a null sink gives true silence. 2 is a rounding step each way.
        silent_peak: 2,
        // Measured under 0.0001 of full scale; this is -60 dB.
        silent_tone: 0.001,
        // Worst measured 0.975: the marker through an Ogg file in the browser.
        marker_correlation: 0.95,
        // Against a WAV's own numbers, and against what `oggdec` makes of an Ogg
        // file: measured 1 step on both platforms, one step of rounding.
        exact_peak: 2,
        decoded_peak: 2,
        // Worst measured 0.29 dB, once commands' moments are left out. Ticket 2048:
        // `windows repeat:loop` failed at 1.06 dB in CI run 42341397532 (attempt 1),
        // on a recording with a 10 ms packet of zeros in it (2049), not noise. The 20
        // jobs of CI run 42389680314 read 0.000 there 17 times and 0.268 3 times, and
        // 0.268 was Windows' worst repeat: twice that is under 1.0, so it stays.
        repeat_db: 1.0,
    ),
    // An equal-work ratio's limits. `max_ratio` is 1 plus twice the worst distance
    // from 1 of a median of old against old over the three runs, and at least 1.05;
    // `max_spread` is twice the worst interquartile range, and at least 0.05. Each
    // sits well under what the injected slowdown shows where it `slows`: at least
    // 1.68 in the browser, 1.97 natively. Raw times moved by half between runs
    // (native Ogg decode 168 to 255 ms) as machines differ: only ratios are held.
    // A fresh run (CI run 41275055017) stayed inside every `max_ratio`. Its machine
    // was noisy enough to pass three `max_spread`s, which is what they are for: CI
    // measures that again rather than these being widened.
    //
    // Three runs didn't show how far latency and Ogg decode move (ticket 2042): one
    // browser latency median of 1.146 failed a pull request that changed no sound.
    // So these four limits are the same rule over every `sound-parity` artifact from
    // 2573's merge to 2026-11-02: 58 CI runs (41280120626 to 41503572435, gathered
    // by run 41588549868), 77 native attempts and 51 in the browser. Nothing leans:
    // on each, the side measured second was slower about as often as faster (browser
    // latency 220 pairs to 239), so neither is a bias in `capture.py`. More pairs wouldn't hold the old limits: an
    // interquartile range doesn't narrow with them, and a median only with their
    // square root, six times as many for browser latency. Latency doesn't `slows`;
    // its limits still catch a replacement that adds a buffer of 10 ms. The other
    // limits, never exceeded in those runs, stay.
    //
    // Ticket 2046 judged every `sound-parity` artifact from 2042's merge to
    // 2026-11-04 the same way: 59 jobs in 10 CI runs (41689870848 to 41809586244; 20
    // each in 41689870848 and 41785090975, 10 in 41796857018, gathered by run
    // 41879925714), 62 native attempts and 61 in the browser. One median and three
    // ranges went over a limit, and those four numbers are set again by the rule;
    // the rest stay. Nothing leans that a limit feels: the side measured second
    // against the first is within 0.002 of 1 on every metric but browser latency,
    // where it is 0.978 (second faster, 299 pairs to 250), and the turns a, b, b, a
    // put that in the range, never the median. The injected slowdown's least, with
    // the ten runs of CI run 41881473138, was 1.84 natively and 1.53 in the browser,
    // both on file reads.
    performance: {
        "linux-native": {
            // Medians 0.959 to 1.057 (one failed at 1.05, job 13 of CI run
            // 41785090975), ranges up to 0.134 under the 0.17 that stays.
            "file_io_ms": (max_ratio: 1.12, max_spread: 0.17, slows: true),
            // Medians 0.981 to 1.026, ranges up to 0.055: 1 of 62 over 0.05.
            "decode_wav_ms": (max_ratio: 1.05, max_spread: 0.12, slows: true),
            // Medians 0.956 to 1.031, interquartile ranges up to 0.116: 15 of the 77
            // attempts were over 0.05. The injected slowdown's least was 1.95.
            "decode_ogg_ms": (max_ratio: 1.09, max_spread: 0.24, slows: true),
            "cpu_ms": (max_ratio: 1.05, max_spread: 0.10, slows: true),
            "peak_kib": (max_ratio: 1.05, max_spread: 0.22, slows: false),
            // Samples sit near 26.5, 30.5 and 37.5 ms, a tick of the probe's loop and
            // the mixer's period apart, so a run's ratios straddle them: ranges up to
            // 0.227 (18 of 77 over 0.09), medians 0.925 to 1.099.
            "latency_ms": (max_ratio: 1.20, max_spread: 0.46, slows: false),
        },
        "browser-chromium": {
            // A fetch, and decodes only seen to end at a frame, are the noisiest.
            "file_io_ms": (max_ratio: 1.25, max_spread: 0.52, slows: true),
            "decode_wav_ms": (max_ratio: 1.17, max_spread: 0.22, slows: true),
            // Medians 0.873 to 1.089 (one failed at 1.05), ranges up to 0.192. The
            // injected slowdown's least was 1.60. Then (2046) medians 0.871 to 1.087,
            // and one range of 0.587 (CI run 41796857018): a decode is seen to end at
            // a frame, so its times fall on steps of 17 ms, 133 against 250 at worst.
            "decode_ogg_ms": (max_ratio: 1.26, max_spread: 1.18, slows: true),
            // Medians 0.953 to 1.035, ranges up to 0.112 (2046): 1 of 61 over 0.09.
            "cpu_ms": (max_ratio: 1.05, max_spread: 0.23, slows: true),
            "peak_kib": (max_ratio: 1.05, max_spread: 0.05, slows: false),
            // Medians 0.866 to 1.180 (two failed at 1.14), ranges up to 0.400 under
            // the 0.53 that stays: around 29 ms, a few ms of jitter is a big ratio.
            "latency_ms": (max_ratio: 1.36, max_spread: 0.53, slows: false),
        },
        // Windows' limits came from three runs (ticket 3031), and one job in ten failed
        // on them with no sound change. These are the same rule over every
        // `sound-parity-windows` artifact from 3031's merge to 2026-11-04 (ticket 2044):
        // 69 jobs in 12 CI runs (41595169987 to 41785090975; 20 each in 41595469804,
        // 41689870848 and 41785090975; the first 49 gathered by run 41783186508), 101
        // attempts. Nothing leans: the median ratio of the side measured second to the
        // first is within 0.005 of 1 on every metric. The injected slowdown's least was
        // 1.77 (Ogg decode), 1.79 (file reads), 1.86 (WAV) and 57.7 (CPU). A limit no
        // attempt exceeded stays.
        "windows": {
            "file_io_ms": (max_ratio: 1.25, max_spread: 0.50, slows: true),
            // Medians 0.971 to 1.037, ranges up to 0.153: 27 of 101 over 0.05.
            "decode_wav_ms": (max_ratio: 1.05, max_spread: 0.31, slows: true),
            // Medians 0.965 to 1.053 (one failed at 1.05), ranges up to 0.194: 19 over
            // 0.05.
            "decode_ogg_ms": (max_ratio: 1.11, max_spread: 0.39, slows: true),
            // Medians 0.850 to 1.094 (two failed at 1.05), ranges up to 0.341 (24 over
            // 0.10): a process's cycles over three seconds of a 10 ms period.
            "cpu_ms": (max_ratio: 1.30, max_spread: 0.69, slows: true),
            // Medians 0.970 to 1.025, ranges up to 0.106: 6 over 0.05.
            "peak_kib": (max_ratio: 1.05, max_spread: 0.22, slows: false),
            // Medians 0.917 to 1.062, ranges up to 0.177: 1 over 0.15.
            "latency_ms": (max_ratio: 1.08, max_spread: 0.36, slows: false),
        },
        // A new backend against itself, as its platform's old one is: at first the same
        // limits as that one's, which three runs held (ticket 3031), then the same rule
        // over the same 69 jobs, 86 attempts (ticket 2044). Nothing leans, as above. The
        // injected slowdown's least was 1.84 (file reads), 1.86 (WAV), 1.93 (Ogg) and
        // 26.2 (CPU).
        "windows-in-house": {
            "file_io_ms": (max_ratio: 1.25, max_spread: 0.50, slows: true),
            // Medians 0.950 to 1.069 (one failed at 1.05), ranges up to 0.150.
            "decode_wav_ms": (max_ratio: 1.14, max_spread: 0.30, slows: true),
            "decode_ogg_ms": (max_ratio: 1.05, max_spread: 0.10, slows: true),
            // Medians 0.927 to 1.065, ranges up to 0.187 (10 over 0.10).
            "cpu_ms": (max_ratio: 1.15, max_spread: 0.38, slows: true),
            "peak_kib": (max_ratio: 1.05, max_spread: 0.05, slows: false),
            // Samples fall anywhere from 6 to 24 ms, a period of the endpoint's buffer,
            // so a ratio of two is noise: medians 0.758 to 1.216, ranges up to 1.139 (5
            // over 0.50). The median still holds: a buffer of 10 ms more is about 1.75.
            "latency_ms": (max_ratio: 1.25, max_spread: 2.28, slows: false),
        },
        // Its own noise, over the 20 runs of CI run 41595469804, stays inside the
        // limits `browser-chromium` had before ticket 2042 (latency medians 0.906 to
        // 1.051, spread at most 0.150; Ogg decode 0.989 to 1.006, 0.052), so they stay.
        "browser-in-house": {
            "file_io_ms": (max_ratio: 1.25, max_spread: 0.52, slows: true),
            "decode_wav_ms": (max_ratio: 1.17, max_spread: 0.22, slows: true),
            "decode_ogg_ms": (max_ratio: 1.05, max_spread: 0.19, slows: true),
            "cpu_ms": (max_ratio: 1.05, max_spread: 0.09, slows: true),
            "peak_kib": (max_ratio: 1.05, max_spread: 0.05, slows: false),
            "latency_ms": (max_ratio: 1.14, max_spread: 0.53, slows: false),
        },
    },
    // The adapters against the old path (ticket 2210), from CI run 41366247884 and
    // the runs named in the ticket's notes. Natively it is the same libraries on the
    // same bytes, so new may not be slower: `max_ratio` is `performance`'s floor,
    // though new measured 0.37 on WAV and 0.76 on Ogg, spread under 0.01, and the
    // injected slowdown showed 1.81 and 2.03. A browser decodes with its own code on
    // its own threads, seen to end at a frame, so there the ratio is only written
    // down (0.53 on WAV, 1.26 on Ogg). `max_share` is about ten times the worst
    // measured: 0.0026 natively and 0.0045 in the browser of a sound's length, as raw
    // times move by half between machines. It leaves room for twenty streams at once.
    //
    // Over 49 Windows and 52 native jobs from 3031's merge (ticket 2044), the ratio
    // leaned on which side went first. A process's first decode was slow (Windows
    // WAV: new 4.8 % slower first, in 48 of 49 jobs, ranges up to 0.109), and natively
    // new decoded Ogg 2.7 % slower just after old (49 of 52, ranges up to 0.059,
    // inconclusive). So each side now decodes once untimed and they take turns old,
    // new, new, old. Over the 20 jobs of CI run 41785090975 with that, neither leans
    // (5 and 13 of 20). Native WAV leans a little (new 3 % slower first, 17 of 20),
    // inside a range of 0.022. The worst ranges are 0.029 and 0.040 on Windows (WAV,
    // Ogg) and 0.022 and 0.037 natively. Windows' WAV spread is twice its worst; the
    // rest were never exceeded and stay. The injected slowdown's least was 1.93 and
    // 1.95 on Windows, 1.96 and 1.99 natively.
    decoders: {
        "linux-native": {
            "wav": (ratio: Some((max_ratio: 1.05, max_spread: 0.05, slows: true)), max_share: 0.03),
            "ogg": (ratio: Some((max_ratio: 1.05, max_spread: 0.05, slows: true)), max_share: 0.03),
        },
        "browser-chromium": {
            "wav": (ratio: None, max_share: 0.05),
            "ogg": (ratio: None, max_share: 0.05),
        },
        "windows": {
            "wav": (ratio: Some((max_ratio: 1.05, max_spread: 0.06, slows: true)), max_share: 0.03),
            "ogg": (ratio: Some((max_ratio: 1.05, max_spread: 0.05, slows: true)), max_share: 0.03),
        },
    },
    // The mixer (ticket 3030). quad-snd has no offline mix to compare with, so this
    // is a share of the sound's own length: 32 voices, at other rates and looped,
    // two of them streams, in release builds (`mixer` in the probe). `max_share` is
    // about ten times the worst measured, as `decoders`' is, since raw times move
    // between machines: natively 0.0131 (CI runs 41388831798, 41390002604 and
    // 41391211198, medians 106 to 130 ms for 10 seconds of sound), in the browser
    // 0.0282 (run 41391211198, one run so far). `min_slowdown` is what doubling a
    // measure must show at the least: it measured 2.00 and 1.98.
    mixer: {
        "linux-native": (max_share: 0.13, min_slowdown: 1.5),
        "browser-chromium": (max_share: 0.28, min_slowdown: 1.5),
        "windows": (max_share: 0.15, min_slowdown: 1.5),
    },
    // A stream holds a worker's ring of 4096 frames and a voice's 128, however long
    // it is: bounded by construction, measured the same over 1 and 10 seconds.
    mixer_memory: (max_held_frames: 4224),
    // A new backend against the old one on its platform (ticket 3031): the same
    // workload in turn, so a ratio is new over old. They are different work, so 1 is
    // no target: each limit is a guard a quarter past the worst measured, and each
    // spread twice the worst. On Windows, CI runs 41407007407, 41413879571 and
    // 41419687839: CPU 2.52, 3.16 and 3.16 times quad-snd's cycles (spread at most
    // 0.30), a little under 1 % of a core; latency 0.23, 0.22 and 0.23 of its own (19
    // ms against 85; the limit holds it near the ticket's aim of 30); memory 0.71. In
    // the browser, over the 20 runs of CI run 41595469804 (ticket 2042): latency 1.659
    // to 1.965 of quad-snd's (about 54 ms against 30), spread at most 0.473; CPU 1.07
    // to 1.11; memory 1.00. Its latency had been set from one run, 1.80.
    old_new: {
        "windows-in-house": {
            "cpu_ms": (max_ratio: 4.0, max_spread: 0.60, slows: false),
            "peak_kib": (max_ratio: 0.85, max_spread: 0.05, slows: false),
            "latency_ms": (max_ratio: 0.35, max_spread: 0.10, slows: false),
        },
        "browser-in-house": {
            "cpu_ms": (max_ratio: 1.35, max_spread: 0.10, slows: false),
            "peak_kib": (max_ratio: 1.05, max_spread: 0.05, slows: false),
            "latency_ms": (max_ratio: 2.46, max_spread: 0.95, slows: false),
        },
    },
    // How long a new backend may take to be heard again, from when an endpoint is back
    // after the one it played on went away: the second the ticket gives a player whose
    // headphones came out, in milliseconds.
    device_loss_ms: {
        "windows-in-house": 1000,
    },
    // Each platform's evidence. Only a `Captured` one can support a parity claim,
    // and every cell of it is mandatory. `Blocked` says who must establish it.
    platforms: {
        "linux-native": Captured,
        "browser-chromium": Captured,
        "windows": Captured,
        "windows-in-house": NewBackend,
        "browser-in-house": NewBackend,
        "macos": Blocked("3032 establishes capture first; hosted Mac capture is unproved"),
    },
)
