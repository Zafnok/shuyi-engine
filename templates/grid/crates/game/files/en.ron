// {{name}}'s English: every screen's text by key. A `{name}` that is an
// action's name shows the player's key for it ({Confirm}), `{Cursor}`
// the four direction keys.
{
    // The keys and layouts the engine names.
    "keys.not_mapped": "! not mapped",
    "keys.arrows": "arrows",
    "keys.chord_join": "+",
    "layout.arrows": "Arrows",

    // The stage.
    "stage.turn": "Turn {turn}",
    "stage.your_move": "Walk to the goal",
    "stage.won": "You reached the goal!",
    "stage.caught": "The wanderer caught you.",
    "stage.help": "{Cursor} step · {Cancel} leave",
    "stage.help.over": "{Confirm} play again · {Cancel} leave",
}
