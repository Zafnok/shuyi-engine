// The grid stage's part of the project file: `shuyi new` merges it into
// the base's.
(
    // `cargo shuyi lint`: check-keys, check-text and the rules crate's
    // fence (clippy's bans in crates/rules/clippy.toml, and no screen or
    // device crate under it), each finding with its file and line.
    rules: "{{crate_name}}-rules",

    // `cargo shuyi check-text`: no screen text written in the code, asked
    // for by key from files/en.ron instead. The tool program and the
    // window aren't screens.
    check_text: (
        dir: "crates/game/src",
        max_literals: 0,
        skip: [
            "crates/game/src/main.rs",
            "crates/game/src/stages/top_down_grid/tools.rs",
        ],
        hint: "put the text in files/en.ron and ask for it by key with ctx.text",
        name_hint: "show a name through the game's language file, not its data's English",
    ),

    check_keys: (
        rust: ["crates/rules/src"],
    ),
)
