// Shuyi Engine's own template: what `shuyi new` makes a game from. Each
// part is a folder of files, written when its `when` holds; the format is
// in the engine's docs/templates.md.
Template(
    id: "shuyi-default",
    name: "Shuyi Engine's own template",
    version: "1.0.0",
    engine: ">=0.1, <0.2",
    license: "MIT OR Apache-2.0",
    format_version: 1,
    questions: [
        Question(
            id: "perspective",
            text: "Which perspectives?",
            pick: Many,
            answers: [
                Answer(id: "top-down-grid", text: "a top-down grid, turn by turn"),
            ],
            default: [],
        ),
        // `yes` needs `shuyi new --private-url <repository>` (ADR-0111).
        Question(
            id: "private-files",
            text: "Keep the game's writing, art and sounds in a private repository?",
            pick: One,
            answers: [
                Answer(id: "yes", text: "yes: a second, private repository, checked out over the game's files"),
                Answer(id: "no", text: "no: every file in the game's own repository"),
            ],
            default: ["no"],
        ),
        // No part serves it: `shuyi new`'s composer copies each skill's
        // worked examples (`example.ron`, `example-*.ron`, `example/`) into
        // `.claude/skills/` unless the answer is `no` (ADR-0113).
        Question(
            id: "examples",
            text: "Include the engine skills' worked examples (bots.rs, playtest.ron…)?",
            pick: One,
            answers: [
                Answer(id: "yes", text: "yes: each skill's worked example, to read and run"),
                Answer(id: "no", text: "no: the skills alone, their examples left in the engine"),
            ],
            default: ["yes"],
        ),
    ],
    // `shuyi new <dir> --template <name>`.
    short_names: {
        // One screen, ready for the rest.
        "blank": {},
        // A turn-based grid stage, with its rules, a bot and records.
        "grid": { "perspective": ["top-down-grid"] },
    },
    parts: [
        // Every game: the title, the short path, the project file, the
        // rules for agents and CI with the gates.
        Part(
            id: "base",
            when: Always,
            files: "base",
            targets: ["desktop", "web"],
        ),
        // A top-down grid stage, with a rules crate over `TurnRules`.
        Part(
            id: "stage-top-down-grid",
            when: Picked("perspective", "top-down-grid"),
            files: "stages/top-down-grid",
            stage: Some("top-down-grid"),
            requires: ["base"],
        ),
        // The game's private files (ADR-0111): `shuyi.ron`'s
        // `private_assets`, `/private/` ignored, the CI step that checks
        // them out, and what AGENTS.md and README.md say of them. The
        // build that lays them over the files is the base's.
        Part(
            id: "private-files",
            when: Picked("private-files", "yes"),
            files: "private-files",
            requires: ["base"],
        ),
    ],
)
