// {{name}}'s project file: what `cargo shuyi <command>` (the engine's
// tools) builds and runs here. Paths are from this folder.
(
    command: "cargo shuyi",

    // The game's tool program, for the commands that run the game:
    // frame-png, lang-status, check, run, scene, replay, bots, import.
    game: (package: "{{crate}}", example: "tools", features: ["tools"]),

    // `cargo shuyi check-keys`: no key named in the game's code or text.
    // `cargo shuyi check --target all`: the targets the game ships on (the
    // engine's profiles, `targets/` in its repository), each with its
    // frame in pixels (48 × 24 cells of 8 × 16), its scale (`integer` or
    // `fit`) and its smallest text's height (the font's cell).
    targets: {
        "desktop": (frame: (384, 384), scale: integer, text_px: 16),
        "web": (frame: (384, 384), scale: integer, text_px: 16),
    },

    check_keys: (
        rust: ["crates/game/src"],
        assets: ["crates/game/files"],
        not_text: ["crates/game/files/keymap.ron"],
        hint: "react to an action (the keymap names the keys), or name a key through the player's keymap",
    ),
)
