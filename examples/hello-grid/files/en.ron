    "key_bindings.reserved": "That key can't be used",
    "key_bindings.change": "Change",
    "key_bindings.clear": "Clear",
    "key_bindings.hold_to_cancel": "hold any button to cancel",
    "key_bindings.restore_keys": "Restore the default keys for {layout}?",
