// Hello, Grid's English: every screen's text by key. The engine's
// screens (options, Key bindings, the dialogue box) name their keys; this
// file gives them their words, and the game's own after them. A `{name}`
// that is an action's name shows that action's key ({Confirm}), `{Cursor}`
// the cursor keys.
{
    // The engine's screens.
    "text_box.help": "{done} done · {delete} delete · {cancel} cancel",
    "dialogue.skip_question": "Skip scene?",
    "dialogue.skip_answers": "{Confirm} yes / {Cancel} no",
    "dialogue.log_hint": "{DialogueLog} log",
    "dialogue.log.title": "Log",
    "dialogue.log.back_to_latest": "Back to latest",
    "dialogue.log.help": "{Cursor} move · {Confirm} go to this line · {Cancel} close",
    "options.title": "Options",
    "options.row.text_speed": "Text speed",
    "options.row.fullscreen": "Fullscreen",
    "options.row.theme": "Colors",
    "options.row.music_volume": "Music volume",
    "options.row.sound_volume": "Sound volume",
    "options.row.key_bindings": "Key bindings",
    "options.row.restore_defaults": "Restore defaults",
    "options.value.on": "On",
    "options.value.off": "Off",
    "options.value.slow": "Slow",
    "options.value.normal": "Normal",
    "options.value.fast": "Fast",
    "options.value.instant": "Instant",
    "options.message.restored": "Defaults restored",
    "options.message.not_saved": "Couldn't save: the change lasts until you quit",
