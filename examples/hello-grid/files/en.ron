    "options.help.restore": "{Cursor} move · {Confirm} restore · {Cancel} back",
    "options.help.none": "{Cursor} move · {Cancel} back",
    "options.help.question": "{Confirm} yes · {Cancel} no",
    "options.question.keep": "Keep these changes?",
    "options.leave.keep": "Keep",
    "options.leave.discard": "Discard",
    "options.leave.back": "Back",
    "options.help.leave": "{Cursor} choose · {Confirm} pick · {Cancel} back",
    "key_bindings.title": "Key bindings",
