// Hello, Grid's look on a black and white screen (ADR-0008 §4): each
// role of `palette.ron` drawn in 8 × 8 patterns, `fg` for what is drawn in
// its colour (a glyph, a rectangle), `bg` for a cell's background in it
// (`fg` again if not said). As the colour skin is light on dark, so is
// this one. `cargo shuyi frame-png --target playdate` paints it.
(
    roles: {
        // The engine's: text white on black, never dithered.
        "text": (fg: White, bg: Black),
        "text_dim": (fg: White, bg: Black),
        "panel": (fg: Black),
        "border": (fg: White),
        "highlight": (fg: White, bg: Black),
        "warning": (fg: White, bg: Black),
        // The focused item is a bar of panel text on it.
        "focus": (fg: White),
        "background": (fg: Black),
        "accent": (fg: White, bg: Black),
        "bright": (fg: White, bg: Black),

        // The map's. A role that shares its colour with another has its
        // patterns: the frame can't tell them apart.
        "floor_fg": (fg: White),
        "floor_bg": (fg: Black),
        "wall_fg": (fg: White),
        "wall_bg": (fg: Dither50),
        // As `highlight`.
        "goal_fg": (fg: White, bg: Black),
        "goal_bg": (fg: Inverted(HLines)),
        // As `focus`.
        "hero": (fg: White),
        // As `threat`: the foe's glyph is drawn in checks.
        "foe": (fg: Checker2, bg: Black),
        "threat": (fg: Checker2, bg: Black),
        "path": (fg: White),
        // As `bright`.
        "cursor": (fg: White, bg: Black),
        "move": (fg: Dither75),
    },

    // What the colours tell apart, which one bit must too: your piece from
    // the foe, and the floor from the walls and the goal.
    distinct: [
        ["hero", "foe"],
        ["floor_bg", "wall_bg", "goal_bg"],
    ],

    // The roles text is drawn in (a highlight is a bar as well as text).
    text: ["text", "text_dim", "warning", "accent", "bright"],
)
