// Hello, Grid's project file: what `cargo shuyi <command>` (the engine's
// tools) builds and runs here. Paths are from this folder.
(
    command: "cargo shuyi",

    // The game's tool program, for `frame-png` and `lang-status`.
    game: (package: "hello-grid", example: "tools", features: ["tools"]),

    // `cargo shuyi font-atlas files-src/ter-u16n.bdf files/font`: the
    // atlas of Terminus, with every glyph the game draws
    // (`hello_grid::REQUIRED_GLYPHS`; a test keeps the two equal).
    font_atlas: (
        required_glyphs: " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~·…─│┌┐└┘├┤┬┴┼═║╔╗╚╝▓▲▼◄►",
        readme: "README.md",
    ),

    // `cargo shuyi glyph-tiles`: the sprite skin's tileset, drawn from the
    // font and the palette. The terrains first, in `TerrainId` order, with
    // the glyph skin's glyphs and colors (`hello_grid::map::TERRAIN_LOOKS`),
    // then the two pieces on clear tiles (`HERO_TILE`, `FOE_TILE`); a test
    // checks the list against the code and the picture against this.
    glyph_tiles: (
        font: "files/font",
        palette: "files/palette.ron",
        out: "files/tiles.png",
        tile: 24,
        columns: 8,
        tiles: [
            (glyphs: ". ", fg: "floor_fg", bg: "floor_bg"),
            (glyphs: "▓▓", fg: "wall_fg", bg: "wall_bg"),
            (glyphs: "[]", fg: "goal_fg", bg: "goal_bg"),
            (glyphs: "@", fg: "hero"),
            (glyphs: "&", fg: "foe"),
        ],
    ),

    // `cargo shuyi check --target all`: the targets it ships on, each with
    // its frame (48 × 24 cells of 8 × 16), its scale and its smallest text
    // (the font's cell). Not the Playdate: the README says why.
    targets: {
        "desktop": (frame: (384, 384), scale: integer, text_px: 16),
        "web": (frame: (384, 384), scale: integer, text_px: 16),
        "steam-deck": (frame: (384, 384), scale: integer, text_px: 16),
    },

    // `cargo shuyi web --release`: the web build, in `dist/web/`. With
    // `--capture`, the capture mode: it runs `capture.ron` beside the page
    // (CI's `web-render` job copies `capture/frames.ron` there) and logs
    // each capture to the browser's console.
    web: (
        package: "hello-grid",
        bin: "hello-grid",
        title: "Hello, Grid",
        dist: "dist/web",
        features: ["capture"],
    ),

    // The game's own license texts: each goes whole into the
    // `NOTICES.txt` that `cargo shuyi web` writes beside the page.
    notices: (texts: ["files/font/Terminus-LICENSE.txt"]),
)
