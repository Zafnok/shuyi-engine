// The playtest's checks (`cargo shuyi playtest`): how often each hero of
// `src/tools.rs`'s ENTRANTS should reach the goal, and that the walker
// gets there faster. The bands hold for seeds 0 to 49: the random hero
// won 5 of them, the walker all 50 (ticket 2126).
[
    // A random walker sometimes finds the goal; never finding it means
    // the stage can't be won, which blocks the run.
    Rate(
        entrant: "random",
        success: [(measure: "won", min: Some(1))],
        band: (min: 5, max: 20),
        floor: Some(1),
    ),
    // A plain walk to the goal nearly always outruns the foe.
    Rate(
        entrant: "walk",
        success: [(measure: "won", min: Some(1))],
        band: (min: 90, max: 100),
    ),
    // And it wins in fewer turns.
    Median(
        entrant: "walk",
        measure: "turns",
        among: [(measure: "won", min: Some(1))],
        want: Lower,
        than: "random",
    ),
]
