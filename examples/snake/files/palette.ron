// Snake's colors by name: the engine's (its screens and widgets draw with
// them), and the board's after them.
{
    // The engine's.
    "text": "#e4e4dc",
    "text_dim": "#8a8a80",
    "panel": "#16161c",
    "border": "#5a5a6e",
    "highlight": "#ffd75a",
    "warning": "#ff7a5a",
    "focus": "#5ac8ff",
    "background": "#0a0a0e",
    "accent": "#a0e07a",
    "bright": "#ffffff",
    // A key's name in a hint ("{Confirm} play"): no `key_bg`, so the
    // cells behind it stay the line's.
    "key": "#c8a0ff",

    // The board's.
    "floor_fg": "#34343e",
    "floor_bg": "#16161c",
    "wall_fg": "#8c8ca0",
    "wall_bg": "#3c3c4e",
    "head": "#d8ff7a",
    "body": "#6ac85a",
    "food": "#ff5a6e",
}
